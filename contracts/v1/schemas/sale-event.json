{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enightx.com/schemas/v1/sale-event.json",
  "title": "SaleEvent",
  "type": "object",
  "required": [
    "event_id",
    "tenant_id",
    "branch_id",
    "device_id",
    "device_generation",
    "source_sequence",
    "schema_version",
    "occurred_at",
    "actor_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "device_generation": {
      "type": "integer",
      "minimum": 1
    },
    "source_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": "string"
    },
    "causal_reference": {
      "type": ["string", "null"]
    },
    "payload": {
      "type": "object",
      "required": [
        "sale_id",
        "receipt_number",
        "subtotal",
        "discount_total",
        "tax_total",
        "grand_total",
        "lines",
        "tenders"
      ],
      "properties": {
        "sale_id": {
          "type": "string",
          "format": "uuid"
        },
        "receipt_number": {
          "type": "string"
        },
        "shift_id": {
          "type": "string",
          "format": "uuid"
        },
        "customer_id": {
          "type": ["string", "null"]
        },
        "subtotal": {
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$"
        },
        "discount_total": {
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$"
        },
        "tax_total": {
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$"
        },
        "grand_total": {
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "line_id",
              "product_id",
              "product_name",
              "barcode",
              "quantity",
              "unit_price",
              "discount_rate",
              "discount_fixed",
              "tax_rate",
              "line_total"
            ],
            "properties": {
              "line_id": { "type": "string", "format": "uuid" },
              "product_id": { "type": "string" },
              "product_name": { "type": "string" },
              "barcode": { "type": "string" },
              "quantity": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
              "unit_price": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
              "discount_rate": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
              "discount_fixed": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
              "tax_rate": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
              "line_total": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" }
            }
          }
        },
        "tenders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tender_id", "tender_type", "amount_tendered", "change_given"],
            "properties": {
              "tender_id": { "type": "string", "format": "uuid" },
              "tender_type": { "type": "string", "enum": ["CASH", "CARD", "QR", "CREDIT"] },
              "amount_tendered": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
              "change_given": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
              "payment_reference": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
