{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enightx.com/schemas/v1/customer-settlement.json",
  "title": "CustomerSettlementRequest",
  "type": "object",
  "required": [
    "customer_id",
    "tenant_id",
    "branch_id",
    "counter_id",
    "amount",
    "payment_method",
    "actor_id"
  ],
  "properties": {
    "customer_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "branch_id": { "type": "string" },
    "counter_id": { "type": "string" },
    "amount": { "type": "string" },
    "payment_method": { "type": "string", "enum": ["CASH", "CARD", "QR", "BANK_TRANSFER"] },
    "reference_id": { "type": ["string", "null"] },
    "actor_id": { "type": "string" },
    "notes": { "type": ["string", "null"] },
    "occurred_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
