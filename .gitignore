# .gitignore for Enightx POS

# Secrets and local config (CRITICAL: never commit credentials)
.env
*.env
!.env.example
*.pem
*.key
*.pfx
*.p12
*.secret

# .NET / C#
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Local databases and logs
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
logs/
*.log

# Review bundles and local drops
review/submissions/*/artifacts/

# OS files
.DS_Store
Thumbs.db
