# Environment configuration template for Enightx POS Backend API
# NOTE: DO NOT commit actual secrets or production values to Git.

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true

# API Server Host & Port
HOST=0.0.0.0
PORT=8000

# Security & Tokens
SECRET_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM_SECRET_KEY
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# PostgreSQL Database Connection
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=enightx_pos
POSTGRES_USER=enightx_user
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Tenant Authorization & Licensing Public Key
LICENCE_SIGNING_PUBLIC_KEY="PLACEHOLDER_ED25519_PUBLIC_KEY"
