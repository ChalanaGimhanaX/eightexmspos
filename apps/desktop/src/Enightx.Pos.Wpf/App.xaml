<Application x:Class="Enightx.Pos.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Application-wide styling -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0D47A1" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#002171" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00C853" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F7FA" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#757575" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0" />
    </Application.Resources>
</Application>
