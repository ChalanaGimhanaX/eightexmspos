<Application x:Class="Enightx.Pos.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Dictionary 0: Global Typography & Trilingual Fallback Scale -->
                <ResourceDictionary Source="/Themes/Typography.xaml" />

                <!-- Dictionary 1: Active Theme Palette (Default Light, swapped dynamically by ThemeManager) -->
                <ResourceDictionary Source="/Themes/Light.xaml" />

                <!-- Dictionary 2: Shared Touch Controls, Minimum 48px Hit Areas & Composite Styles -->
                <ResourceDictionary Source="/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
