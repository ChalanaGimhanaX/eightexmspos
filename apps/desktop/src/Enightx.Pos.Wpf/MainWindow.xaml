<Window x:Class="Enightx.Pos.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enightx POS - Counter Terminal" Height="768" Width="1024"
        WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Update Notification Banner (Hidden when no update) -->
        <Border x:Name="UpdateBanner" Grid.Row="0" Background="#1565C0" Padding="14,8" Visibility="Collapsed">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚀 " FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateBannerText" Text="A new software update is available!" 
                               FontWeight="SemiBold" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Update Now" Height="28" Padding="14,2" Margin="0,0,8,0"
                            Background="White" Foreground="#1565C0" FontWeight="Bold" FontSize="12"
                            Click="OpenUpdateDialog_Click"/>
                    <Button Content="✕" Width="28" Height="28" Background="Transparent" BorderThickness="0"
                            Foreground="White" FontWeight="Bold" FontSize="13"
                            Click="DismissUpdateBanner_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Navigation Bar (Visible when logged in) -->
        <Border x:Name="NavBar" Grid.Row="1" Background="{StaticResource PrimaryDarkBrush}" Padding="12,6" Visibility="Collapsed">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ENIGHTX POS" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="📊 Dashboard" Height="30" Padding="10,2" Margin="0,0,4,0"
                            Background="#00897B" Foreground="White" FontWeight="Bold" Click="NavDashboard_Click"/>
                    <Button Content="🛒 Retail" Height="30" Padding="10,2" Margin="0,0,4,0"
                            Background="#1565C0" Foreground="White" FontWeight="SemiBold" Click="NavBilling_Click"/>
                    <Button Content="📦 Inventory" Height="30" Padding="10,2" Margin="0,0,4,0"
                            Background="#1565C0" Foreground="White" FontWeight="SemiBold" Click="NavTransfers_Click"/>
                    <Button Content="📦 GRN" Height="30" Padding="10,2" Margin="0,0,4,0"
                            Background="#1565C0" Foreground="White" FontWeight="SemiBold" Click="NavReceiving_Click"/>
                    <Button Content="👥 Customers" Height="30" Padding="10,2" Margin="0,0,4,0"
                            Background="#1565C0" Foreground="White" FontWeight="SemiBold" Click="NavCustomers_Click"/>
                    <Button Content="🧾 Sales Report" Height="30" Padding="10,2" Margin="0,0,4,0"
                            Background="#1565C0" Foreground="White" FontWeight="SemiBold" Click="NavSalesHistory_Click"/>
                    <Button Content="💵 Cashier Balance" Height="30" Padding="10,2" Margin="0,0,4,0"
                            Background="#2E7D32" Foreground="White" FontWeight="SemiBold" Click="NavCashierBalance_Click"/>
                    <Button Content="💵 Cash In/Out" Height="30" Padding="10,2" Margin="0,0,4,0"
                            Background="#455A64" Foreground="White" FontWeight="SemiBold" Click="NavCashMovement_Click"/>
                    <Button Content="💾 Backup" Height="30" Padding="10,2" Margin="0,0,4,0"
                            Background="#455A64" Foreground="White" FontWeight="SemiBold" Click="NavBackup_Click"/>
                    <Button Content="🔑 License" Height="30" Padding="10,2" Margin="0,0,4,0"
                            Background="#455A64" Foreground="White" FontWeight="SemiBold" Click="NavLicense_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Language Switcher -->
                    <Border Background="#263238" CornerRadius="4" Padding="2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="EN" Width="28" Height="24" Background="Transparent" Foreground="White" BorderThickness="0"
                                    FontWeight="Bold" FontSize="11" Click="LangEn_Click"/>
                            <Button Content="සිං" Width="28" Height="24" Background="Transparent" Foreground="White" BorderThickness="0"
                                    FontWeight="Bold" FontSize="11" Click="LangSi_Click"/>
                            <Button Content="த" Width="28" Height="24" Background="Transparent" Foreground="White" BorderThickness="0"
                                    FontWeight="Bold" FontSize="11" Click="LangTa_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Sync Status Badge -->
                    <Button x:Name="SyncStatusBadge" Height="26" Padding="8,0" Margin="0,0,10,0"
                            Background="#2E7D32" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="11"
                            ToolTip="Click to trigger manual cloud sync" Click="ManualSync_Click">
                        <TextBlock x:Name="SyncStatusText" Text="🟢 ONLINE"/>
                    </Button>

                    <Button Content="🔒 Close Shift" Height="30" Padding="10,2" Margin="0,0,6,0"
                            Background="#C62828" Foreground="White" FontWeight="Bold" Click="NavCloseShift_Click"/>
                    <Button Content="Logout" Height="30" Padding="10,2"
                            Background="#37474F" Foreground="White" FontWeight="SemiBold" Click="NavLogout_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="MainContainer" Grid.Row="2">
            <!-- Content dynamically switches between LoginView and BillingView -->
        </Grid>
    </Grid>
</Window>
