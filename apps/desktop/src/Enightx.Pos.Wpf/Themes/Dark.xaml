<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- COLOR TOKENS (DARK THEME - REDUCED GLARE)                                 -->
    <!-- ========================================================================= -->

    <!-- Brand & Accent Colors -->
    <Color x:Key="PrimaryColor">#3B82F6</Color>
    <Color x:Key="PrimaryDarkColor">#1D4ED8</Color>
    <Color x:Key="PrimaryLightColor">#1E3A8A</Color>
    <Color x:Key="SecondaryColor">#94A3B8</Color>
    <Color x:Key="AccentColor">#10B981</Color>

    <!-- Canvas & Surface Colors -->
    <Color x:Key="BackgroundColor">#0F172A</Color>
    <Color x:Key="SurfaceColor">#1E293B</Color>
    <Color x:Key="CardColor">#1E293B</Color>
    <Color x:Key="CardHoverColor">#334155</Color>
    <Color x:Key="HeaderBackgroundColor">#1E293B</Color>
    <Color x:Key="RowAlternateColor">#182234</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="BorderFocusColor">#60A5FA</Color>

    <!-- Feedback & Semantics Colors -->
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="SuccessSurfaceColor">#14532D</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningSurfaceColor">#78350F</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="DangerSurfaceColor">#7F1D1D</Color>
    <Color x:Key="InfoColor">#38BDF8</Color>
    <Color x:Key="InfoSurfaceColor">#0C4A6E</Color>

    <!-- Typography Colors -->
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <!-- Input Control Colors -->
    <Color x:Key="InputBackgroundColor">#0F172A</Color>
    <Color x:Key="InputBorderColor">#475569</Color>

    <!-- ========================================================================= -->
    <!-- SOLID COLOR BRUSH TOKENS (DARK THEME)                                     -->
    <!-- ========================================================================= -->

    <!-- Brand & Accent Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

    <!-- Canvas & Surface Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource HeaderBackgroundColor}"/>
    <SolidColorBrush x:Key="RowAlternateBrush" Color="{StaticResource RowAlternateColor}"/>

    <!-- Border Brushes -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>

    <!-- Feedback & Semantics Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource SuccessSurfaceColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="{StaticResource InfoSurfaceColor}"/>

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}"/>

    <!-- Input Control Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>

</ResourceDictionary>
