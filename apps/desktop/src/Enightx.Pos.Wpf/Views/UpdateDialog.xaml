<Window x:Class="Enightx.Pos.Wpf.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enightx POS - Software Update" 
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock Text="🚀 Update Available" FontSize="20" FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="#E8F5E9" CornerRadius="12" Padding="8,3" HorizontalAlignment="Right">
                        <TextBlock x:Name="NewVersionBadge" Text="v1.0.1 Available" 
                                   FontWeight="Bold" Foreground="#2E7D32" FontSize="12"/>
                    </Border>
                </DockPanel>
                <TextBlock x:Name="CurrentVersionText" Text="Current installed version: v1.0.0" 
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Release Notes -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="6" Padding="12" Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="What's New in This Release:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Progress Area -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock x:Name="StatusText" Text="Ready to download and install update." 
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="ProgressPercentText" Text="" FontWeight="Bold" 
                               FontSize="12" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                </DockPanel>
                <ProgressBar x:Name="DownloadProgressBar" Height="14" Minimum="0" Maximum="100" Value="0"
                             Foreground="{StaticResource PrimaryBrush}" Background="#E0E0E0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Safe: Local sales &amp; data are preserved." 
                           VerticalAlignment="Center" FontSize="11" Foreground="#78909C"/>

                <Button x:Name="LaterButton" Grid.Column="1" Content="Remind Later" 
                        Width="110" Height="38" Margin="0,0,10,0"
                        Background="#ECEFF1" Foreground="#37474F" FontWeight="SemiBold"
                        Click="LaterButton_Click"/>

                <Button x:Name="UpdateButton" Grid.Column="2" Content="Update &amp; Restart" 
                        Width="140" Height="38"
                        Background="{StaticResource PrimaryBrush}" Foreground="White" 
                        FontWeight="Bold" FontSize="13"
                        Click="UpdateButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
