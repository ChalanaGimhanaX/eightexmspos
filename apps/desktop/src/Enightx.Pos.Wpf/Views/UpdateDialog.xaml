<Window x:Class="Enightx.Pos.Wpf.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enightx POS - Software Update" 
        Height="620" Width="600"
        MinHeight="580" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource PosFontFamily}">
    
    <Grid Margin="20">
        <!-- Modern Card Container with CornerRadius="12" -->
        <Border Background="{DynamicResource SurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                CornerRadius="12" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Banner -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚀 Software Update" FontSize="20" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource SuccessBrush}" 
                            BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right">
                        <TextBlock x:Name="NewVersionBadge" Text="v1.0.1 Available" 
                                   FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" FontSize="12"/>
                    </Border>
                </DockPanel>

                <!-- Version Comparison Card -->
                <Border Grid.Row="1" Background="{DynamicResource CardHoverBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                        CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="INSTALLED VERSION" FontSize="11" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CurrentVersionBadgeText" Text="v1.0.0" FontSize="18" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="➔" FontSize="22" FontWeight="Bold" 
                                   Foreground="{DynamicResource PrimaryBrush}" 
                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0"/>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="TARGET VERSION" FontSize="11" FontWeight="Bold" 
                                       Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TargetVersionBadgeText" Text="v1.0.1" FontSize="18" FontWeight="Bold" 
                                       Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SHA256 Checksum Card -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                        CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="🔒 Cryptographic Package Integrity" FontSize="12" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="{DynamicResource SuccessSurfaceBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="SHA-256 VERIFIED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                            </Border>
                        </DockPanel>
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" 
                                BorderThickness="1" CornerRadius="6" Padding="8,6">
                            <TextBlock x:Name="Sha256ChecksumText" 
                                       Text="SHA256: 7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069" 
                                       FontFamily="Consolas, Courier New, monospace" FontSize="11" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Release Notes Card -->
                <Border Grid.Row="3" Background="{DynamicResource BackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                        CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="What's New in This Release:" FontWeight="SemiBold" FontSize="13" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Progress & Status Area -->
                <StackPanel Grid.Row="4" Margin="0,0,0,14">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="StatusText" Text="Ready to download and install update." 
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="ProgressPercentText" Text="" FontWeight="Bold" 
                                   FontSize="13" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <ProgressBar x:Name="DownloadProgressBar" Height="14" Minimum="0" Maximum="100" Value="0"
                                 Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource CardHoverBrush}" 
                                 BorderThickness="0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Action Buttons: Check, Remind Later, Update & Restart (All >= 48px) -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CheckButton" Grid.Column="0" Content="🔄 Check Now" 
                            Height="48" MinWidth="130" Style="{DynamicResource TouchSecondaryButtonStyle}" 
                            Click="CheckButton_Click"/>

                    <Button x:Name="LaterButton" Grid.Column="2" Content="Remind Later" 
                            Height="48" MinWidth="130" Margin="0,0,12,0"
                            Style="{DynamicResource TouchSecondaryButtonStyle}" 
                            Click="LaterButton_Click"/>

                    <Button x:Name="UpdateButton" Grid.Column="3" Content="🚀 Update &amp; Restart" 
                            Height="48" MinWidth="180"
                            Style="{DynamicResource TouchPrimaryButtonStyle}" 
                            Click="UpdateButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
