<Window x:Class="Enightx.Pos.Wpf.Views.HeldBillsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Held Bills (Parked Carts)" Height="460" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" Padding="14" CornerRadius="6" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="📂 PARKED / HELD BILLS" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeldCountText" Text="0 Bills Held" HorizontalAlignment="Right" Foreground="#BBDEFB" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Held Bills Grid -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid x:Name="HeldBillsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                      RowHeight="40" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Note / Reference" Binding="{Binding Note}" Width="*" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Held At (UTC)" Binding="{Binding HeldAtUtc, StringFormat={}{0:HH:mm:ss}}" Width="110"/>
                    <DataGridTextColumn Header="Items" Binding="{Binding TotalItems}" Width="70"/>
                    <DataGridTextColumn Header="Total (LKR)" Binding="{Binding GrandTotal, StringFormat={}{0:N2}}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Content="🗑 Discard Selected" Width="140" Height="36" Background="#FFEBEE" Foreground="#C62828"
                    BorderThickness="0" FontWeight="Bold" Click="Discard_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Width="90" Height="36" Margin="0,0,10,0" Background="#ECEFF1" Foreground="#37474F"
                        FontWeight="SemiBold" Click="Close_Click"/>
                <Button Content="↩ Recall Selected Bill" Width="170" Height="36" Background="{StaticResource PrimaryBrush}"
                        Foreground="White" FontWeight="Bold" Click="Recall_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

