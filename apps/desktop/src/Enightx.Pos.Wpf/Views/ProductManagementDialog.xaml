<Window x:Class="Enightx.Pos.Wpf.Views.ProductManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Master Management" Height="720" Width="1080"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏷️ Product Master Management" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <Border Background="#1E88E5" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CATALOG MASTER" FontWeight="Bold" FontSize="11" Foreground="White"/>
                    </Border>
                </StackPanel>
                <Button Content="+ New Product" Height="32" Padding="14,0" Background="#43A047" Foreground="White" 
                        FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand" Click="NewProduct_Click"/>
            </DockPanel>
        </Border>

        <!-- Main Master-Detail Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Search & List -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0">
                <DockPanel>
                    <!-- Search Bar & Filters -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Border Background="#F0F4F8" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="Gray"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1" Height="28" FontSize="13" Background="Transparent"
                                         BorderThickness="0" VerticalContentAlignment="Center"
                                         TextChanged="SearchBox_TextChanged"/>
                            </Grid>
                        </Border>
                        <DockPanel>
                            <CheckBox x:Name="ShowInactiveCheck" Content="Show Inactive Items" FontSize="12" 
                                      VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"/>
                            <TextBlock x:Name="ProductCountText" Text="0 items" FontSize="12" Foreground="Gray" 
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Product List -->
                    <ListBox x:Name="ProductsListBox" SelectionChanged="ProductsListBox_SelectionChanged"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,8" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Width="360">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat=LKR {0:N2}}" HorizontalAlignment="Right" 
                                                       FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                        </DockPanel>
                                        <DockPanel Grid.Row="1" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Barcode}" FontSize="11" Foreground="Gray"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Stock: " FontSize="11" Foreground="Gray"/>
                                                <TextBlock Text="{Binding StockOnHand, StringFormat={}{0:0.##}}" FontWeight="Bold" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StockOnHand}" Value="0">
                                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text=" | Min: " FontSize="11" Foreground="Gray"/>
                                                <TextBlock Text="{Binding MinStockThreshold, StringFormat={}{0:0.##}}" FontSize="11" Foreground="Gray"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right Panel: Product Editor Card -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Form Header -->
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="FormTitleText" Text="Product Details" FontSize="16" FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryDarkBrush}"/>
                            <Border x:Name="LowStockAlertBadge" Background="#FFEBEE" CornerRadius="4" Padding="8,2" 
                                    HorizontalAlignment="Right" Visibility="Collapsed">
                                <TextBlock Text="⚠️ LOW STOCK ALERT" FontWeight="Bold" FontSize="11" Foreground="#C62828"/>
                            </Border>
                        </DockPanel>

                        <!-- Barcode & Auto-Generate -->
                        <TextBlock Text="Barcode / EAN *" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BarcodeBox" Grid.Column="0" Height="34" FontSize="14" Padding="6,4" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Content="⚡ Generate" Height="34" Padding="12,0" Background="#ECEFF1" 
                                    Foreground="#37474F" FontWeight="SemiBold" Cursor="Hand" Click="GenerateBarcode_Click"/>
                        </Grid>

                        <!-- Name (English) -->
                        <TextBlock Text="Product Name (English) *" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameBox" Height="34" FontSize="14" Padding="6,4" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

                        <!-- Sinhala & Tamil Localized Names -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Name (Sinhala)" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                                <TextBox x:Name="NameSiBox" Height="34" FontSize="13" Padding="6,4" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Name (Tamil)" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                                <TextBox x:Name="NameTaBox" Height="34" FontSize="13" Padding="6,4" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Category Dropdown -->
                        <TextBlock Text="Category" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CategoryCombo" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"
                                  DisplayMemberPath="Name" SelectedValuePath="CategoryId"/>

                        <!-- Prices & Taxes (3 Columns) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Unit Price (LKR) *" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox x:Name="UnitPriceBox" Height="34" FontSize="14" FontWeight="Bold" Padding="6,4" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cost Basis (LKR) *" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox x:Name="CostBasisBox" Height="34" FontSize="14" Padding="6,4" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Tax Rate (%)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox x:Name="TaxRateBox" Height="34" FontSize="14" Padding="6,4" Text="0.00" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Stock on Hand & Minimum Stock Threshold (2 Columns) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Current Stock On Hand" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="StockOnHandBox" Height="34" FontSize="14" Padding="6,4" IsReadOnly="True" 
                                         Background="#F5F7FA" VerticalContentAlignment="Center"/>
                                <TextBlock Text="* Adjusted via Goods Receiving, Sales, or Counts" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Minimum Stock Threshold *" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox x:Name="MinThresholdBox" Height="34" FontSize="14" FontWeight="Bold" Padding="6,4" Text="5.00" VerticalContentAlignment="Center"/>
                                <TextBlock Text="* Low-stock warning trigger level" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Active State Toggle -->
                        <CheckBox x:Name="IsActiveCheckBox" Content="Product is Active (Available at Checkout)" IsChecked="True" 
                                  FontSize="13" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <!-- Error Banner -->
                        <Border x:Name="ErrorBanner" Background="#FFEBEE" CornerRadius="4" Padding="8" Margin="0,0,0,14" Visibility="Collapsed">
                            <TextBlock x:Name="ErrorText" Foreground="#C62828" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Action Buttons -->
                        <DockPanel>
                            <Button x:Name="DeleteButton" Content="🗑️ Deactivate" Height="40" Padding="14,0" 
                                    Background="#EF5350" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                                    Cursor="Hand" Click="DeleteProduct_Click" Visibility="Collapsed"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Close" Width="90" Height="40" Background="#ECEFF1" 
                                        Foreground="#37474F" FontWeight="SemiBold" BorderThickness="0" 
                                        Margin="0,0,10,0" Cursor="Hand" Click="Close_Click"/>
                                <Button x:Name="SaveButton" Content="💾 Save Product" Height="40" Padding="20,0" 
                                        Background="{StaticResource PrimaryBrush}" Foreground="White" 
                                        FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="SaveProduct_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>

