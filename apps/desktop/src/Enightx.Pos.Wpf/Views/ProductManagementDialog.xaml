<Window x:Class="Enightx.Pos.Wpf.Views.ProductManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Master Management" Height="780" Width="1120"
        MinHeight="720" MinWidth="1040"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource PosFontFamily}"
        Loaded="Window_Loaded">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏷️ Product Master Management" FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="6" 
                            Padding="8,4" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CATALOG MASTER" FontWeight="Bold" FontSize="11" 
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Border>
                </StackPanel>
                <Button Content="+ New Product" Height="48" MinWidth="160" Padding="16,0" 
                        Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource TextOnPrimaryBrush}" 
                        FontWeight="Bold" FontSize="14" BorderThickness="0" HorizontalAlignment="Right" 
                        Cursor="Hand" Click="NewProduct_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>
        </Border>

        <!-- Main Master-Detail Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Search & Master List Card -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="12" Padding="16" Margin="0,0,14,0">
                <DockPanel>
                    <!-- Search Bar & Filter Controls -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <!-- Product Search Input >= 48px -->
                        <Border Background="{DynamicResource InputBackgroundBrush}" 
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" 
                                CornerRadius="10" Height="48" Padding="10,0" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" 
                                           Margin="2,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1" Height="48" FontSize="14" 
                                         FontFamily="{StaticResource PosFontFamily}"
                                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0" VerticalContentAlignment="Center"
                                         TextChanged="SearchBox_TextChanged"/>
                            </Grid>
                        </Border>
                        <DockPanel>
                            <CheckBox x:Name="ShowInactiveCheck" Content="Show Inactive Items" FontSize="13" 
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"/>
                            <TextBlock x:Name="ProductCountText" Text="0 items" FontSize="13" 
                                       Foreground="{DynamicResource TextMutedBrush}" 
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Product Master List (Row Height >= 48px) -->
                    <ListBox x:Name="ProductsListBox" SelectionChanged="ProductsListBox_SelectionChanged"
                             BorderThickness="0" Background="Transparent" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="MinHeight" Value="56"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{DynamicResource SurfaceBrush}" 
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                                    CornerRadius="8" Padding="12,10" SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                                   TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                        <TextBlock Text="{Binding UnitPrice, StringFormat='Rs. {0:#,##0.00}'}" 
                                                   HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" 
                                                   Foreground="{DynamicResource PrimaryBrush}"/>
                                    </DockPanel>
                                    <DockPanel Grid.Row="1" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Barcode}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="Stock: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding StockOnHand, StringFormat={}{0:0.##}}" FontWeight="Bold" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StockOnHand}" Value="0">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text=" | Min: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding MinStockThreshold, StringFormat={}{0:0.##}}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right Panel: Product Editor Card -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="12" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Form Header -->
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="FormTitleText" Text="Product Details" FontSize="18" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border x:Name="LowStockAlertBadge" Background="{DynamicResource DangerSurfaceBrush}" 
                                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" 
                                    CornerRadius="6" Padding="10,4" HorizontalAlignment="Right" Visibility="Collapsed">
                                <TextBlock Text="⚠️ LOW STOCK ALERT" FontWeight="Bold" FontSize="12" 
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </Border>
                        </DockPanel>

                        <!-- Barcode & Auto-Generate (>= 48px) -->
                        <TextBlock Text="Barcode / EAN *" FontWeight="SemiBold" FontSize="13" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BarcodeBox" Grid.Column="0" Height="48" FontSize="15" 
                                     Style="{DynamicResource TouchTextBoxStyle}"/>
                            <Button Grid.Column="2" Content="⚡ Generate" Height="48" MinWidth="130" Padding="14,0" 
                                    Style="{DynamicResource TouchSecondaryButtonStyle}" Cursor="Hand" Click="GenerateBarcode_Click"/>
                        </Grid>

                        <!-- English Product Name (>= 48px) -->
                        <TextBlock Text="Product Name (English) *" FontWeight="SemiBold" FontSize="13" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameBox" Height="48" FontSize="15" Margin="0,0,0,14" 
                                 Style="{DynamicResource TouchTextBoxStyle}"/>

                        <!-- Sinhala & Tamil Localized Names (>= 48px) -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Name (Sinhala) - සිංහල නම" FontSize="13" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="NameSiBox" Height="48" FontSize="14" 
                                         FontFamily="{StaticResource PosFontFamily}"
                                         Style="{DynamicResource TouchTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Name (Tamil) - தமிழ் பெயர்" FontSize="13" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="NameTaBox" Height="48" FontSize="14" 
                                         FontFamily="{StaticResource PosFontFamily}"
                                         Style="{DynamicResource TouchTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Category Dropdown (>= 48px) -->
                        <TextBlock Text="Category" FontWeight="SemiBold" FontSize="13" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CategoryCombo" Height="48" Margin="0,0,0,14" 
                                  FontSize="14" VerticalContentAlignment="Center"
                                  DisplayMemberPath="Name" SelectedValuePath="CategoryId"/>

                        <!-- Prices & Taxes (Rs. Formatted, >= 48px) -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Unit Price (Rs.) *" FontWeight="SemiBold" FontSize="13" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="UnitPriceBox" Height="48" FontSize="16" FontWeight="Bold" 
                                         Style="{DynamicResource TouchTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cost Basis (Rs.) *" FontWeight="SemiBold" FontSize="13" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="CostBasisBox" Height="48" FontSize="15" 
                                         Style="{DynamicResource TouchTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Tax Rate (%)" FontWeight="SemiBold" FontSize="13" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TaxRateBox" Height="48" FontSize="15" Text="0.00" 
                                         Style="{DynamicResource TouchTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Stock on Hand & Minimum Stock Threshold (>= 48px) -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Current Stock On Hand" FontSize="13" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="StockOnHandBox" Height="48" FontSize="15" IsReadOnly="True" 
                                         Background="{DynamicResource CardHoverBrush}" 
                                         Style="{DynamicResource TouchTextBoxStyle}"/>
                                <TextBlock Text="* Adjusted via Goods Receiving, Sales, or Counts" FontSize="11" 
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Minimum Stock Threshold *" FontWeight="SemiBold" FontSize="13" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="MinThresholdBox" Height="48" FontSize="15" FontWeight="Bold" Text="5.00" 
                                         Style="{DynamicResource TouchTextBoxStyle}"/>
                                <TextBlock Text="* Low-stock warning trigger level" FontSize="11" 
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Active State Toggle -->
                        <CheckBox x:Name="IsActiveCheckBox" Content="Product is Active (Available at Checkout)" 
                                  IsChecked="True" FontSize="14" FontWeight="SemiBold" 
                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,18"/>

                        <!-- Error Banner -->
                        <Border x:Name="ErrorBanner" Background="{DynamicResource DangerSurfaceBrush}" 
                                BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" 
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
                            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" 
                                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Action Buttons (Add, Save, Delete, Close >= 48px) -->
                        <DockPanel>
                            <Button x:Name="DeleteButton" Content="🗑️ Deactivate" Height="48" MinWidth="140" Padding="16,0" 
                                    Background="{DynamicResource DangerBrush}" Foreground="{DynamicResource TextOnPrimaryBrush}" 
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="DeleteProduct_Click" 
                                    Visibility="Collapsed">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Close" Height="48" MinWidth="110" 
                                        Style="{DynamicResource TouchSecondaryButtonStyle}" 
                                        Margin="0,0,12,0" Cursor="Hand" Click="Close_Click"/>
                                <Button x:Name="SaveButton" Content="💾 Save Product" Height="48" MinWidth="170" Padding="20,0" 
                                        Style="{DynamicResource TouchPrimaryButtonStyle}" 
                                        Cursor="Hand" Click="SaveProduct_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
