<Window x:Class="Enightx.Pos.Wpf.Views.ShiftOpenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Shift &amp; Cash Drawer" Height="440" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" Padding="16" CornerRadius="6" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="COUNTER / SHIFT OPENING" FontWeight="Bold" FontSize="16" Foreground="White"/>
                <TextBlock x:Name="UserInfoText" Text="Cashier: ... | Branch: B01 | Counter: C01" FontSize="12" Foreground="#BBDEFB" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Opening Cash Float (LKR)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                <TextBlock Text="Count and enter the initial physical cash in the drawer before starting billing:" 
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBox x:Name="FloatInput" Height="44" FontSize="20" FontWeight="Bold" Padding="10,4"
                         VerticalContentAlignment="Center" Text="5000.00"/>

                <!-- Quick Amount Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,16">
                    <Button Content="LKR 2,000" Padding="10,4" Margin="0,0,8,0" Background="#ECEFF1" BorderThickness="0"
                            FontWeight="SemiBold" Click="QuickFloat_Click"/>
                    <Button Content="LKR 5,000" Padding="10,4" Margin="0,0,8,0" Background="#ECEFF1" BorderThickness="0"
                            FontWeight="SemiBold" Click="QuickFloat_Click"/>
                    <Button Content="LKR 10,000" Padding="10,4" Margin="0,0,8,0" Background="#ECEFF1" BorderThickness="0"
                            FontWeight="SemiBold" Click="QuickFloat_Click"/>
                </StackPanel>

                <TextBlock Text="Branch ID:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox x:Name="BranchInput" Height="32" Margin="0,2,0,8" Text="B01" IsReadOnly="True" Background="#ECEFF1"/>

                <TextBlock Text="Counter ID:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox x:Name="CounterInput" Height="32" Margin="0,2,0,0" Text="C01" IsReadOnly="True" Background="#ECEFF1"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="100" Height="38" Margin="0,0,12,0" Background="#ECEFF1" Foreground="#37474F"
                    FontWeight="SemiBold" Click="Cancel_Click"/>
            <Button Content="Open Shift &amp; Start Billing" Width="200" Height="38"
                    Background="{StaticResource PrimaryBrush}" Foreground="White" FontWeight="Bold"
                    Click="OpenShift_Click"/>
        </StackPanel>
    </Grid>
</Window>

