<Window x:Class="Enightx.Pos.Wpf.Views.CashMovementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cash Drawer Movement (Cash In / Out)" Height="420" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" Padding="14" CornerRadius="6" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="💵 CASH DRAWER MOVEMENT" FontWeight="Bold" FontSize="16" Foreground="White"/>
                <TextBlock x:Name="ShiftInfoText" Text="Shift: ... | Counter: C01" FontSize="12" Foreground="#BBDEFB" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Movement Type:" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="RadioCashIn" Content="Cash In (Add Float)" IsChecked="True" FontWeight="SemiBold"
                                 Foreground="#2E7D32" Margin="0,0,24,0"/>
                    <RadioButton x:Name="RadioCashOut" Content="Cash Out (Petty Cash / Paid Out)" FontWeight="SemiBold"
                                 Foreground="#C62828"/>
                </StackPanel>

                <TextBlock Text="Amount (LKR):" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="AmountInput" Height="40" FontSize="18" FontWeight="Bold" Padding="8,4"
                         VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                <TextBlock Text="Mandatory Reason / Note:" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ReasonInput" Height="64" TextWrapping="Wrap" AcceptsReturn="True" Padding="6" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Height="36" Margin="0,0,10,0" Background="#ECEFF1" Foreground="#37474F"
                    FontWeight="SemiBold" Click="Cancel_Click"/>
            <Button Content="Confirm Movement" Width="160" Height="36" Background="{StaticResource PrimaryBrush}"
                    Foreground="White" FontWeight="Bold" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>

