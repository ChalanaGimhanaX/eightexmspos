<Window x:Class="Enightx.Pos.Wpf.Views.DailyReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily Store Performance &amp; Financial Report" Height="750" Width="820"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA" Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="📅 Daily Store Performance &amp; Financial Report" FontSize="20" FontWeight="Bold" Foreground="#1A365D"/>
                    <TextBlock x:Name="SubtitleText" Text="Loading daily report..." FontSize="13" Foreground="#718096" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Date:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#4A5568"/>
                    <DatePicker x:Name="ReportDatePicker" Height="32" Width="130" Margin="0,0,8,0"
                                SelectedDateChanged="ReportDatePicker_SelectedDateChanged"/>
                    <Button Content="🔄 Refresh" Height="32" Padding="12,0" Margin="0,0,8,0"
                            Background="#EDF2F7" Foreground="#2D3748" FontWeight="SemiBold" BorderThickness="1" BorderBrush="#CBD5E0" Cursor="Hand"
                            Click="Refresh_Click"/>
                    <Button Content="🖨️ Print Daily Report" Height="34" Padding="14,0"
                            Background="#2B6CB0" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            Click="Print_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Report Scroll Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ReportContentPanel" Margin="0,0,10,0">
                <!-- KPI Highlight Grid -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Net Sales Revenue" Foreground="#718096" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="KpiNetSalesText" Text="LKR 0.00" FontWeight="Bold" FontSize="17" Foreground="#2B6CB0" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Gross Profit" Foreground="#718096" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="KpiGrossProfitText" Text="LKR 0.00" FontWeight="Bold" FontSize="17" Foreground="#38A169" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Transactions / Shifts" Foreground="#718096" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="KpiTxnCountText" Text="0 txns / 0 shifts" FontWeight="Bold" FontSize="15" Foreground="#2D3748" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Net Drawer Cash Change" Foreground="#718096" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="KpiDrawerCashText" Text="LKR 0.00" FontWeight="Bold" FontSize="17" Foreground="#D69E2E" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Section 1: Sales & Refunds Summary -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SALES &amp; REFUNDS SUMMARY" FontWeight="Bold" FontSize="13" Foreground="#2D3748" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Gross Sales:" Foreground="#718096" FontSize="12"/>
                                <TextBlock x:Name="GrossSalesText" Text="LKR 0.00" FontWeight="Bold" FontSize="16" Foreground="#2D3748"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total Discounts:" Foreground="#718096" FontSize="12"/>
                                <TextBlock x:Name="DiscountsText" Text="LKR 0.00" FontWeight="Bold" FontSize="16" Foreground="#E53E3E"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tax (VAT 18%):" Foreground="#718096" FontSize="12"/>
                                <TextBlock x:Name="TaxText" Text="LKR 0.00" FontWeight="Bold" FontSize="16" Foreground="#4A5568"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Total Refunds:" Foreground="#718096" FontSize="12"/>
                                <TextBlock x:Name="RefundsText" Text="LKR 0.00" FontWeight="Bold" FontSize="16" Foreground="#C53030"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 2: Tender Breakdown Table -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SALES BREAKDOWN BY TENDER TYPE" FontWeight="Bold" FontSize="13" Foreground="#2D3748" Margin="0,0,0,10"/>
                        <DataGrid x:Name="TenderGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tender Type" Binding="{Binding TenderType}" Width="140" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Txn Count" Binding="{Binding TransactionCount}" Width="100"/>
                                <DataGridTextColumn Header="Total Tendered" Binding="{Binding TotalTendered, StringFormat=LKR {0:N2}}" Width="150"/>
                                <DataGridTextColumn Header="Change Given" Binding="{Binding ChangeGiven, StringFormat=LKR {0:N2}}" Width="140"/>
                                <DataGridTextColumn Header="Net Amount" Binding="{Binding NetAmount, StringFormat=LKR {0:N2}}" Width="*" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Section 3: Cash Drawer Operations -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CASH DRAWER MOVEMENT &amp; RECONCILIATION" FontWeight="Bold" FontSize="13" Foreground="#2D3748" Margin="0,0,0,10"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Net Cash Sales (Tendered - Change):" Foreground="#718096"/>
                            <TextBlock x:Name="NetCashSalesText" Text="LKR 0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="(-) Total Cash Refunds Given:" Foreground="#718096"/>
                            <TextBlock x:Name="CashRefundsText" Text="LKR 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#C53030"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="(+) Total Cash In (Petty Cash / Deposits):" Foreground="#718096"/>
                            <TextBlock x:Name="CashInText" Text="LKR 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#2B6CB0"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="(-) Total Cash Out (Payouts / Expenses):" Foreground="#718096"/>
                            <TextBlock x:Name="CashOutText" Text="LKR 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#DD6B20"/>
                        </DockPanel>
                        <Separator Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Net Drawer Cash Impact:" FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="NetDrawerImpactText" Text="LKR 0.00" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="#2B6CB0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Section 4: Gross Profit Breakdown -->
                <Border Background="#F7FAFC" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="STORE GROSS PROFIT &amp; MARGIN SUMMARY" FontWeight="Bold" FontSize="13" Foreground="#2D3748" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Net Sales Revenue:" Foreground="#718096"/>
                            <TextBlock x:Name="ProfitRevText" Text="LKR 0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Cost of Goods Sold (COGS):" Foreground="#718096"/>
                            <TextBlock x:Name="ProfitCogsText" Text="LKR 0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </DockPanel>
                        <Separator Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Gross Profit:" FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="GrossProfitText" Text="LKR 0.00" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="#2B6CB0"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Gross Margin %:" FontWeight="Bold" FontSize="13" Foreground="#718096"/>
                            <TextBlock x:Name="GrossMarginText" Text="0.00%" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="#38A169"/>
                        </DockPanel>
                        <TextBlock Text="* Gross Profit only (excludes operating, staff salaries, and store rental expenses)." FontSize="11" Foreground="Gray" FontStyle="Italic"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,14,0,0">
            <Button Content="Close" Width="100" Height="36" HorizontalAlignment="Right"
                    Background="#EDF2F7" Foreground="#4A5568" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                    Click="Close_Click"/>
        </Border>
    </Grid>
</Window>

