<Window x:Class="Enightx.Pos.Wpf.Views.DailyReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily Store Performance &amp; Financial Report" Height="780" Width="860"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource PosFontFamily}"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="📅 Daily Store Performance &amp; Financial Report" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SubtitleText" Text="Loading daily report..." 
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Date:" VerticalAlignment="Center" FontWeight="SemiBold" 
                               Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <DatePicker x:Name="ReportDatePicker" Height="48" MinHeight="48" Width="140" Margin="0,0,8,0"
                                VerticalContentAlignment="Center"
                                SelectedDateChanged="ReportDatePicker_SelectedDateChanged"/>
                    <Button Content="🔄 Refresh" Height="48" MinHeight="48" Padding="14,0" Margin="0,0,8,0"
                            Style="{StaticResource TouchSecondaryButtonStyle}"
                            Click="Refresh_Click"/>
                    <Button Content="🖨️ Print Daily Report" Height="48" MinHeight="48" Padding="16,0"
                            Style="{StaticResource TouchPrimaryButtonStyle}"
                            Click="Print_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Report Scroll Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ReportContentPanel" Margin="0,0,10,0">
                <!-- KPI Highlight Grid (Modern Card Containers, CornerRadius="12") -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Net Sales Revenue -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                            CornerRadius="12" Padding="16" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Net Sales Revenue" Foreground="{DynamicResource TextSecondaryBrush}" 
                                       FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="KpiNetSalesText" Text="Rs. 0.00" FontWeight="Bold" 
                                       FontSize="18" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Gross Profit -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                            CornerRadius="12" Padding="16" Margin="6,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Gross Profit" Foreground="{DynamicResource TextSecondaryBrush}" 
                                       FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="KpiGrossProfitText" Text="Rs. 0.00" FontWeight="Bold" 
                                       FontSize="18" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Transactions / Shifts -->
                    <Border Grid.Column="2" Background="{DynamicResource CardBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                            CornerRadius="12" Padding="16" Margin="6,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Transactions / Shifts" Foreground="{DynamicResource TextSecondaryBrush}" 
                                       FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="KpiTxnCountText" Text="0 txns / 0 shifts" FontWeight="Bold" 
                                       FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Net Drawer Cash Change -->
                    <Border Grid.Column="3" Background="{DynamicResource CardBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                            CornerRadius="12" Padding="16" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Net Drawer Cash Change" Foreground="{DynamicResource TextSecondaryBrush}" 
                                       FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="KpiDrawerCashText" Text="Rs. 0.00" FontWeight="Bold" 
                                       FontSize="18" Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Section 1: Sales & Refunds Summary -->
                <Border Background="{DynamicResource CardBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                        CornerRadius="12" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SALES &amp; REFUNDS SUMMARY" FontWeight="Bold" FontSize="13" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Gross Sales:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="GrossSalesText" Text="Rs. 0.00" FontWeight="Bold" FontSize="16" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total Discounts:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="DiscountsText" Text="Rs. 0.00" FontWeight="Bold" FontSize="16" 
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tax (VAT 18%):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="TaxText" Text="Rs. 0.00" FontWeight="Bold" FontSize="16" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Total Refunds:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="RefundsText" Text="Rs. 0.00" FontWeight="Bold" FontSize="16" 
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 2: Tender Breakdown Table (Strict Rs. #,##0.00 formatting) -->
                <Border Background="{DynamicResource CardBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                        CornerRadius="12" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SALES BREAKDOWN BY TENDER TYPE" FontWeight="Bold" FontSize="13" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <DataGrid x:Name="TenderGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                  RowHeight="48" ColumnHeaderHeight="44"
                                  Style="{StaticResource TouchDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tender Type" Binding="{Binding TenderType}" Width="150" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Txn Count" Binding="{Binding TransactionCount}" Width="100"/>
                                <DataGridTextColumn Header="Total Tendered" 
                                                    Binding="{Binding TotalTendered, StringFormat='Rs. {0:#,##0.00}'}" Width="160"/>
                                <DataGridTextColumn Header="Change Given" 
                                                    Binding="{Binding ChangeGiven, StringFormat='Rs. {0:#,##0.00}'}" Width="150"/>
                                <DataGridTextColumn Header="Net Amount" 
                                                    Binding="{Binding NetAmount, StringFormat='Rs. {0:#,##0.00}'}" Width="*" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Section 3: Cash Drawer Operations -->
                <Border Background="{DynamicResource CardBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                        CornerRadius="12" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="CASH DRAWER MOVEMENT &amp; RECONCILIATION" FontWeight="Bold" FontSize="13" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Net Cash Sales (Tendered - Change):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="NetCashSalesText" Text="Rs. 0.00" HorizontalAlignment="Right" 
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="(-) Total Cash Refunds Given:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="CashRefundsText" Text="Rs. 0.00" HorizontalAlignment="Right" 
                                       FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="(+) Total Cash In (Petty Cash / Deposits):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="CashInText" Text="Rs. 0.00" HorizontalAlignment="Right" 
                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="(-) Total Cash Out (Payouts / Expenses):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="CashOutText" Text="Rs. 0.00" HorizontalAlignment="Right" 
                                       FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                        </DockPanel>
                        <Separator Margin="0,0,0,10"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Net Drawer Cash Impact:" FontWeight="Bold" FontSize="14" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="NetDrawerImpactText" Text="Rs. 0.00" HorizontalAlignment="Right" 
                                       FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryBrush}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Section 4: Gross Profit Breakdown -->
                <Border Background="{DynamicResource CardBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                        CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="STORE GROSS PROFIT &amp; MARGIN SUMMARY" FontWeight="Bold" FontSize="13" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Net Sales Revenue:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="ProfitRevText" Text="Rs. 0.00" HorizontalAlignment="Right" 
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Cost of Goods Sold (COGS):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="ProfitCogsText" Text="Rs. 0.00" HorizontalAlignment="Right" 
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>
                        <Separator Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Gross Profit:" FontWeight="Bold" FontSize="14" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="GrossProfitText" Text="Rs. 0.00" HorizontalAlignment="Right" 
                                       FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryBrush}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Gross Margin %:" FontWeight="Bold" FontSize="13" 
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="GrossMarginText" Text="0.00%" HorizontalAlignment="Right" 
                                       FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SuccessBrush}"/>
                        </DockPanel>
                        <TextBlock Text="* Gross Profit only (excludes operating, staff salaries, and store rental expenses)." 
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Close" Width="120" Height="48" MinHeight="48" HorizontalAlignment="Right"
                    Style="{StaticResource TouchSecondaryButtonStyle}"
                    Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
