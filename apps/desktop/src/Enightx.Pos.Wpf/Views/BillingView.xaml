<UserControl x:Class="Enightx.Pos.Wpf.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1280"
             Loaded="BillingView_Loaded"
             FontFamily="{StaticResource PosFontFamily}">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Row 0: Sleek Kiosk Context Bar (52px) -->
            <RowDefinition Height="52"/>
            <!-- Row 1: 3-Column Billing Sales Terminal Workspace -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Status Bar Ribbon (38px) -->
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: CLEAN DISTRACTION-FREE KIOSK HEADER                                -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="16,6" SnapsToDevicePixels="True">
            <DockPanel>
                <!-- Left: Terminal Context -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ COUNTER BILLING" FontWeight="Bold" FontSize="16" 
                               Foreground="{DynamicResource TextOnPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource PrimaryDarkBrush}" CornerRadius="4" 
                            Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentShift.CounterId, StringFormat='COUNTER {0}'}" 
                                   FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextOnPrimaryBrush}"/>
                    </Border>
                    <Border Background="{DynamicResource PrimaryDarkBrush}" CornerRadius="4" 
                            Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentShift.BranchId, StringFormat='BRANCH {0}'}" 
                                   FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextOnPrimaryBrush}"/>
                    </Border>
                </StackPanel>
                
                <!-- Right: Active Shift Float & Cashier Context -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Shift Float Pill -->
                    <Border Background="{DynamicResource PrimaryDarkBrush}" CornerRadius="6" 
                            Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="● OPEN" Foreground="{DynamicResource AccentBrush}" 
                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text=" | Float: " Foreground="{DynamicResource TextOnPrimaryBrush}" 
                                       FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentShift.OpeningFloat, StringFormat='Rs. {0:#,##0.00}'}" 
                                       Foreground="{DynamicResource TextOnPrimaryBrush}" FontWeight="Bold" 
                                       FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Cashier Identity Pill -->
                    <Border Background="{DynamicResource PrimaryDarkBrush}" CornerRadius="6" 
                            Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤 " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentUser.DisplayName}" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextOnPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: MAIN BILLING WORKSPACE                                             -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Product Catalog & Quick-Pick Tiles (Width 480px) -->
                <ColumnDefinition Width="480"/>
                <!-- Column 1: Current Sale Cart Table (*) -->
                <ColumnDefinition Width="*"/>
                <!-- Column 2: Bill Summary & Tender Panel (Width 330px) -->
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================================== -->
            <!-- COLUMN 0: PRODUCT QUICK-PICK CATALOG                                  -->
            <!-- ===================================================================== -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="10" Padding="12" Margin="0,0,12,0" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Quick Search Input (48px) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Quick-Pick Category Chips (48px) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Product Tiles Grid (*) -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Quick-Search Box (Minimum 48px Height) -->
                    <Border Grid.Row="0" Background="{DynamicResource InputBackgroundBrush}" 
                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" 
                            CornerRadius="8" Height="48" Margin="0,0,0,10" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Search Icon -->
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="16" HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            
                            <!-- Search Text Input -->
                            <TextBox x:Name="SearchBox" Grid.Column="1" Height="48" FontSize="15" 
                                     FontFamily="{StaticResource PosFontFamily}"
                                     Background="Transparent" BorderThickness="0" 
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="SearchBox_TextChanged"/>
                            
                            <!-- Quick Clear Button (48x48px hit area) -->
                            <Button Grid.Column="2" Content="✕" Width="48" Height="48" 
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" FontWeight="Bold"
                                    Click="ClearSearch_Click"/>
                        </Grid>
                    </Border>

                    <!-- 2. Quick-Pick Category Chips (48px Height, CornerRadius 24) -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" 
                                            Style="{DynamicResource CategoryChipButtonStyle}"
                                            Height="48" MinHeight="48"
                                            Click="CategoryFilter_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 3. Product Quick-Pick Tiles (220x115px Tap Area, Trilingual, Rs. #,##0.00) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Full card tap area (Width 220, MinHeight 115) -->
                                    <Button Margin="0,0,8,8" Width="220" MinHeight="115" Cursor="Hand"
                                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" Click="ProductCard_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="tileBorder" Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                        CornerRadius="8" Padding="10" SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- English / Primary Name -->
                                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" 
                                                                   FontFamily="{StaticResource PosFontFamily}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <!-- Sinhala Name (Unclipped Line Height) -->
                                                        <TextBlock Grid.Row="1" Text="{Binding NameSi}" FontSize="12" 
                                                                   FontFamily="{StaticResource PosFontFamily}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                                   LineStackingStrategy="BlockLineHeight" LineHeight="18"/>

                                                        <!-- Tamil Name (Unclipped Line Height) -->
                                                        <TextBlock Grid.Row="2" Text="{Binding NameTa}" FontSize="12" 
                                                                   FontFamily="{StaticResource PosFontFamily}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,4"
                                                                   LineStackingStrategy="BlockLineHeight" LineHeight="18"/>

                                                        <!-- Barcode & Price Rs. #,##0.00 -->
                                                        <DockPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding Barcode}" FontSize="11" 
                                                                       FontFamily="{StaticResource PosFontFamily}"
                                                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding UnitPrice, StringFormat='Rs. {0:#,##0.00}'}" 
                                                                       FontWeight="Bold" FontSize="14" 
                                                                       FontFamily="{StaticResource PosFontFamily}"
                                                                       Foreground="{DynamicResource PrimaryBrush}" 
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tileBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter TargetName="tileBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="tileBorder" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                        <Setter TargetName="tileBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===================================================================== -->
            <!-- COLUMN 1: CURRENT SALE CART TABLE                                     -->
            <!-- ===================================================================== -->
            <DockPanel Grid.Column="1" Margin="0,0,12,0">
                <!-- Barcode Scanner Input (Height >= 48px) -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                        Padding="8" CornerRadius="8" Margin="0,0,0,10" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:Name="BarcodeInputBox" Grid.Column="0" Height="48" MinHeight="48" FontSize="16" 
                                 FontFamily="{StaticResource PosFontFamily}"
                                 Background="{DynamicResource InputBackgroundBrush}" 
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5"
                                 Padding="12,0" VerticalContentAlignment="Center"
                                 Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="BarcodeInput_KeyDown"/>
                        
                        <Button Grid.Column="1" Content="+ Add Item" Height="48" MinWidth="110" Margin="8,0,0,0"
                                Style="{DynamicResource TouchPrimaryButtonStyle}" Click="AddItem_Click"/>
                    </Grid>
                </Border>

                <!-- Cart Items Table (56px Row Height, 48x48px Touch Steppers & Delete, Rs. #,##0.00) -->
                <DataGrid ItemsSource="{Binding CartItems}" AutoGenerateColumns="False" CanUserAddRows="False"
                          Style="{DynamicResource TouchDataGridStyle}" RowHeight="56" ColumnHeaderHeight="46"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" SnapsToDevicePixels="True">
                    <DataGrid.Columns>
                        <!-- Product Name & Barcode Column -->
                        <DataGridTemplateColumn Header="Product Name" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="14" 
                                                   FontFamily="{StaticResource PosFontFamily}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Barcode}" FontSize="11" 
                                                   FontFamily="{StaticResource PosFontFamily}"
                                                   Foreground="{DynamicResource TextMutedBrush}" 
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- Quantity Stepper Column (Width 160, 48x48px Hit Areas) -->
                        <DataGridTemplateColumn Header="Qty" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Decrement Button (48x48px) -->
                                        <Button Content="-" Style="{DynamicResource TouchStepperButtonStyle}" Click="DecrementQty_Click"/>
                                        
                                        <!-- Quantity Display Text (Width 44) -->
                                        <TextBlock Text="{Binding Quantity, StringFormat={}{0:F0}}" Width="44" 
                                                   TextAlignment="Center" FontWeight="Bold" FontSize="16" 
                                                   FontFamily="{StaticResource PosFontFamily}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        
                                        <!-- Increment Button (48x48px) -->
                                        <Button Content="+" Style="{DynamicResource TouchStepperButtonStyle}" Click="IncrementQty_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Unit Price Column (Width 130, Rs. #,##0.00) -->
                        <DataGridTemplateColumn Header="Unit Price" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button ToolTip="Click to override price (Manager PIN required for Cashier)"
                                            Click="OverridePrice_Click"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            MinHeight="48" MinWidth="48" HorizontalAlignment="Stretch" Padding="0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding UnitPrice, StringFormat='Rs. {0:#,##0.00}'}" 
                                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                                       FontSize="14" FontFamily="{StaticResource PosFontFamily}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="✎" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Line Total Column (Width 130, Rs. #,##0.00) -->
                        <DataGridTemplateColumn Header="Line Total" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LineTotal, StringFormat='Rs. {0:#,##0.00}'}" 
                                               TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                               FontSize="15" FontWeight="Bold" FontFamily="{StaticResource PosFontFamily}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Line Remove Action Column (Width 64, 48x48px Hit Area) -->
                        <DataGridTemplateColumn Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Style="{DynamicResource TouchDeleteButtonStyle}" 
                                            HorizontalAlignment="Center" VerticalAlignment="Center" 
                                            Click="RemoveItem_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- ===================================================================== -->
            <!-- COLUMN 2: BILL SUMMARY & TENDER PANEL                                 -->
            <!-- ===================================================================== -->
            <Border Grid.Column="2" Background="{DynamicResource CardBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                    Padding="18" CornerRadius="10" SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Text="BILL SUMMARY" FontSize="16" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    
                    <!-- Subtotal -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Subtotal:" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Subtotal, StringFormat='Rs. {0:#,##0.00}'}" HorizontalAlignment="Right" 
                                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </DockPanel>
                    
                    <!-- Discounts -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Discounts:" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DiscountTotal, StringFormat='-Rs. {0:#,##0.00}'}" HorizontalAlignment="Right" 
                                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                    </DockPanel>

                    <!-- Tax -->
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="Tax (VAT 18%):" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TaxTotal, StringFormat='Rs. {0:#,##0.00}'}" HorizontalAlignment="Right" 
                                   FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </DockPanel>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Grand Total -->
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="GRAND TOTAL" FontSize="16" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding GrandTotal, StringFormat='Rs. {0:#,##0.00}'}" HorizontalAlignment="Right" 
                                   FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                    </DockPanel>

                    <!-- Apply Discount Action Button -->
                    <Button Content="🏷️ Apply Discount" Height="48" MinHeight="48" MinWidth="100" Margin="0,0,0,12" 
                            Style="{DynamicResource TouchSecondaryButtonStyle}" Click="ApplyDiscount_Click"/>

                    <!-- Large Cash Pay Tender Button (Height 56px) -->
                    <Button Content="💵 PAY CASH (F12)" Style="{DynamicResource BigTenderButtonStyle}" 
                            Height="56" MinHeight="56" Click="PayCash_Click"/>

                    <!-- Quick Tender Shortcuts (48px Height) -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Height="48" Margin="0,0,4,0" 
                                Style="{DynamicResource TouchSecondaryButtonStyle}" Click="PayCard_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💳 Card (F10)" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Grid.Column="1" Height="48" Margin="4,0,0,0" 
                                Style="{DynamicResource TouchSecondaryButtonStyle}" Click="PaySplit_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📝 Split / More" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Held Cart Tray & Cart Actions -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Hold Bill Button (48px Height) -->
                        <Button Grid.Column="0" Height="48" Margin="0,0,4,0" 
                                Style="{DynamicResource TouchSecondaryButtonStyle}" Click="HoldCart_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⏸️ Hold Bill" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Recall Held Bills Button (48px Height with Count Badge) -->
                        <Button Grid.Column="1" Height="48" Margin="4,0,0,0" 
                                Style="{DynamicResource TouchSecondaryButtonStyle}" Click="RecallHeldCarts_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📋 Held Bills" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="12" 
                                        MinWidth="24" Height="24" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HeldCartsCount}" Foreground="{DynamicResource TextOnPrimaryBrush}" 
                                               FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Clear Cart Action (48px Height) -->
                    <Button Content="🗑️ Clear Cart" Height="48" MinHeight="48" MinWidth="48" Margin="0,8,0,0" 
                            Background="{DynamicResource DangerSurfaceBrush}" Foreground="{DynamicResource DangerBrush}"
                            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            FontFamily="{StaticResource PosFontFamily}" FontWeight="SemiBold" FontSize="13" 
                            Cursor="Hand" Click="ClearCart_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="clearBorder" Background="{TemplateBinding Background}" 
                                         BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                         CornerRadius="6" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="clearBorder" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="clearBorder" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 2: STATUS BAR RIBBON                                                  -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" 
                Padding="16,4" SnapsToDevicePixels="True">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" VerticalAlignment="Center" 
                           Foreground="{DynamicResource PrimaryBrush}"/>
                <TextBlock Text="Offline Local Database: Connected | Mode: WAL" HorizontalAlignment="Right" 
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
