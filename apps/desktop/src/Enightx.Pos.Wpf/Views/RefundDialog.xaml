<Window x:Class="Enightx.Pos.Wpf.Views.RefundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Return &amp; Refund Item" Height="560" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F7FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="↩️ Return / Refund Sale" FontSize="20" FontWeight="Bold" Foreground="#1A365D"/>
                <TextBlock Text="Search by original receipt number, select items to return, and specify reason." FontSize="13" Foreground="#718096" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Search Bar -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ReceiptNumberBox" Height="36" FontSize="15" Padding="8,4"
                         ToolTip="Enter receipt number (e.g. B01-C01-000001)"
                         KeyDown="ReceiptNumberBox_KeyDown"/>
                <Button Grid.Column="1" Content="Find Receipt" Height="36" Margin="10,0,0,0"
                        Background="#2B6CB0" Foreground="White" FontWeight="Bold"
                        Cursor="Hand" Click="FindReceipt_Click"/>
            </Grid>
        </Border>

        <!-- Bill Lines Grid -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="40"
                      SelectionChanged="LinesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Purchased Qty" Binding="{Binding Quantity}" Width="95" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=LKR {0:N2}}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat=LKR {0:N2}}" Width="110" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Refund Parameters (Reason, Qty, Restock) -->
        <Border Grid.Row="3" Background="#EDF2F7" CornerRadius="8" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Quantity to Refund:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="RefundQtyBox" Grid.Row="0" Grid.Column="1" Height="32" Text="1" FontSize="14" Padding="6,2" Width="100" HorizontalAlignment="Left"/>
                <CheckBox x:Name="RestockCheckBox" Grid.Row="0" Grid.Column="2" Content="Restock item to inventory" IsChecked="True"
                          FontWeight="SemiBold" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mandatory Reason:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBox x:Name="ReasonBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="32" FontSize="13" Padding="6,2" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <Border Grid.Row="4" Margin="0,16,0,0">
            <DockPanel>
                <Button Content="Cancel" Width="90" Height="38" Background="#EDF2F7" Foreground="#4A5568"
                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="Cancel_Click"/>
                <Button Content="💵 Process Cash Refund" Width="190" Height="38" HorizontalAlignment="Right"
                        Background="#C53030" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="ProcessRefund_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

