<Window x:Class="Enightx.Pos.Wpf.Views.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Management" Height="480" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" Padding="16" CornerRadius="6" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="DialogTitleText" Text="👤 CREATE NEW USER" FontWeight="Bold" FontSize="16" Foreground="White"/>
                <TextBlock Text="Configure staff credentials and role permissions" FontSize="12" Foreground="#BBDEFB" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Username:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameInput" Height="36" Padding="8,4" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="Display Name (Full Name):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="DisplayNameInput" Height="36" Padding="8,4" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="Role Assignment:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="RoleCombo" Height="36" FontSize="14" Margin="0,0,0,12">
                    <ComboBoxItem Content="Cashier" IsSelected="True"/>
                    <ComboBoxItem Content="Manager"/>
                    <ComboBoxItem Content="Owner"/>
                </ComboBox>

                <TextBlock x:Name="PasswordLabel" Text="Initial Password:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordInput" Height="36" Padding="8,4" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock x:Name="PasswordHelpText" Text="Must be at least 4 characters." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Height="36" Margin="0,0,10,0" Background="#ECEFF1" Foreground="#37474F"
                    FontWeight="SemiBold" Click="Cancel_Click"/>
            <Button x:Name="SaveBtn" Content="Save User" Width="120" Height="36"
                    Background="{StaticResource PrimaryBrush}" Foreground="White" FontWeight="Bold"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
