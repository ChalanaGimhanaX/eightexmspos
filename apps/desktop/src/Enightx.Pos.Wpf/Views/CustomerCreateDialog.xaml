<Window x:Class="Enightx.Pos.Wpf.Views.CustomerCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register New Customer" Height="360" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="12" CornerRadius="4" Margin="0,0,0,16">
            <TextBlock Text="NEW CUSTOMER REGISTRATION" FontWeight="Bold" FontSize="15" Foreground="White"/>
        </Border>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Full Name:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="NameInput" Height="34" Margin="0,0,0,10" Padding="6,2" VerticalContentAlignment="Center"/>

            <TextBlock Text="Phone Number:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="PhoneInput" Height="34" Margin="0,0,0,10" Padding="6,2" VerticalContentAlignment="Center"/>

            <TextBlock Text="NIC / Business Reg No (BRN):" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="NicInput" Height="34" Margin="0,0,0,10" Padding="6,2" VerticalContentAlignment="Center"/>

            <TextBlock Text="Credit Limit (LKR):" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="CreditLimitInput" Height="34" Text="10000.00" Padding="6,2" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Height="34" Margin="0,0,10,0" Background="#ECEFF1" Foreground="#37474F" Click="Cancel_Click"/>
            <Button Content="Save Customer" Width="130" Height="34" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="Bold" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>

