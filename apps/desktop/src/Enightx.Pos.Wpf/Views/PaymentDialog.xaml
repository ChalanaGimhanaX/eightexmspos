<Window x:Class="Enightx.Pos.Wpf.Views.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cash Payment" Height="480" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Total Payable" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding GrandTotal, StringFormat=LKR {0:F2}}" FontSize="32" FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,20"/>

            <TextBlock Text="Cash Tendered (LKR)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
            <TextBox x:Name="TenderBox" Height="44" FontSize="20" FontWeight="Bold" Padding="8,6"
                     Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Quick Cash Buttons -->
            <UniformGrid Columns="4" Margin="0,12,0,16">
                <Button Content="Exact" Height="36" Margin="2" Click="Exact_Click"/>
                <Button Content="+500" Height="36" Margin="2" Click="Add500_Click"/>
                <Button Content="+1,000" Height="36" Margin="2" Click="Add1000_Click"/>
                <Button Content="+5,000" Height="36" Margin="2" Click="Add5000_Click"/>
            </UniformGrid>

            <!-- Change Due -->
            <Border Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock Text="Change Due:" FontSize="16" FontWeight="SemiBold" Foreground="#2E7D32"/>
                    <TextBlock Text="{Binding ChangeDue, StringFormat=LKR {0:F2}}" FontSize="20" FontWeight="Bold" 
                               HorizontalAlignment="Right" Foreground="#1B5E20"/>
                </DockPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <!-- Action Buttons -->
            <DockPanel Margin="0,8,0,0">
                <Button Content="Cancel" Width="100" Height="44" Click="Cancel_Click" Background="#ECEFF1"/>
                <Button Content="Complete Sale" Height="44" Margin="12,0,0,0" 
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        FontWeight="Bold" FontSize="16" IsEnabled="{Binding CanComplete}" Click="Complete_Click"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
