<Window x:Class="Enightx.Pos.Wpf.Views.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment &amp; Checkout" Height="580" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <StackPanel>
            <!-- Total Payable Banner -->
            <TextBlock Text="Total Payable" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding GrandTotal, StringFormat=LKR {0:F2}}" FontSize="30" FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,14"/>

            <!-- Tender Type Selection -->
            <Border Background="#ECEFF1" CornerRadius="6" Padding="4" Margin="0,0,0,14">
                <UniformGrid Columns="4">
                    <RadioButton Content="💵 Cash" GroupName="TenderType" IsChecked="{Binding IsCashSelected}" 
                                 Checked="TenderRadio_Checked" Tag="CASH" FontSize="13" FontWeight="SemiBold" 
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"/>
                    <RadioButton Content="💳 Card" GroupName="TenderType" IsChecked="{Binding IsCardSelected}" 
                                 Checked="TenderRadio_Checked" Tag="CARD" FontSize="13" FontWeight="SemiBold" 
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"/>
                    <RadioButton Content="📝 Credit" GroupName="TenderType" IsChecked="{Binding IsCreditSelected}" 
                                 Checked="TenderRadio_Checked" Tag="CREDIT" FontSize="13" FontWeight="SemiBold" 
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"/>
                    <RadioButton Content="🔀 Split" GroupName="TenderType" IsChecked="{Binding IsSplitSelected}" 
                                 Checked="TenderRadio_Checked" Tag="SPLIT" FontSize="13" FontWeight="SemiBold" 
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"/>
                </UniformGrid>
            </Border>

            <!-- Customer Selection (Required for Credit and Split, Optional for others) -->
            <StackPanel Margin="0,0,0,12">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Customer (for Credit / Ledger):" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{Binding CustomerAvailableCredit, StringFormat='Avail Credit: LKR {0:N2}'}" 
                               HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#2E7D32"/>
                </DockPanel>
                <ComboBox x:Name="CustomerCombo" Height="36" ItemsSource="{Binding Customers}" 
                          SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" 
                          FontSize="13" VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- Cash Tender View -->
            <StackPanel x:Name="CashTenderPanel">
                <TextBlock Text="Cash Tendered (LKR)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                <TextBox x:Name="TenderBox" Height="40" FontSize="18" FontWeight="Bold" Padding="8,4"
                         Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Quick Cash Buttons -->
                <UniformGrid Columns="4" Margin="0,8,0,12">
                    <Button Content="Exact" Height="32" Margin="2" Click="Exact_Click"/>
                    <Button Content="+500" Height="32" Margin="2" Click="Add500_Click"/>
                    <Button Content="+1,000" Height="32" Margin="2" Click="Add1000_Click"/>
                    <Button Content="+5,000" Height="32" Margin="2" Click="Add5000_Click"/>
                </UniformGrid>
            </StackPanel>

            <!-- Card Tender View -->
            <Border x:Name="CardTenderPanel" Visibility="Collapsed" Background="#E3F2FD" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <TextBlock Text="💳 Swipe / Tap customer card on bank POS machine. Ensure payment transaction approves before completing." 
                           FontSize="13" Foreground="#1565C0" TextWrapping="Wrap"/>
            </Border>

            <!-- Credit Tender View -->
            <Border x:Name="CreditTenderPanel" Visibility="Collapsed" Background="#FFF3E0" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="📝 This entire bill will be assigned to customer credit (&quot;Naya&quot;)." 
                               FontWeight="Bold" FontSize="13" Foreground="#E65100" Margin="0,0,0,4"/>
                    <TextBlock Text="Credit sales do NOT increase cash drawer expected cash." FontSize="12" Foreground="#BF360C"/>
                </StackPanel>
            </Border>

            <!-- Split Tender View -->
            <StackPanel x:Name="SplitTenderPanel" Visibility="Collapsed" Margin="0,0,0,8">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Credit Portion (LKR)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="CreditPortionBox" Height="36" FontSize="16" FontWeight="Bold" Padding="6,4"
                                 Text="{Binding CreditAmount, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cash Portion (LKR)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="CashPortionBox" Height="36" FontSize="16" FontWeight="Bold" Padding="6,4"
                                 Text="{Binding CashAmount, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Change Due -->
            <Border Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="Change Due:" FontSize="15" FontWeight="SemiBold" Foreground="#2E7D32"/>
                    <TextBlock Text="{Binding ChangeDue, StringFormat=LKR {0:F2}}" FontSize="18" FontWeight="Bold" 
                               HorizontalAlignment="Right" Foreground="#1B5E20"/>
                </DockPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <!-- Action Buttons -->
            <DockPanel Margin="0,4,0,0">
                <Button Content="Cancel" Width="100" Height="44" Click="Cancel_Click" Background="#ECEFF1" Foreground="#37474F"/>
                <Button Content="Complete Sale" Height="44" Margin="12,0,0,0" 
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        FontWeight="Bold" FontSize="16" IsEnabled="{Binding CanComplete}" Click="Complete_Click"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
