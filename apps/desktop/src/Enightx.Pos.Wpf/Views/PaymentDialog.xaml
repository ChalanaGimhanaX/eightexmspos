<Window x:Class="Enightx.Pos.Wpf.Views.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment &amp; Checkout" Height="680" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource PosFontFamily}">
    <Grid Margin="20">
        <!-- Modern Card Container (CornerRadius="12") -->
        <Border Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                CornerRadius="12" Padding="20">
            <StackPanel>
                <!-- Total Payable Banner with Strict Rs. #,##0.00 Formatting -->
                <TextBlock Text="Total Payable" FontSize="13" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding GrandTotal, StringFormat='Rs. {0:#,##0.00}'}" 
                           FontSize="32" FontWeight="Bold" 
                           Foreground="{DynamicResource PrimaryBrush}" 
                           HorizontalAlignment="Center" Margin="0,2,0,16"/>

                <!-- Tender Method Selector: Touch Tiles (Minimum 48px Height) -->
                <Border Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                        CornerRadius="10" Padding="4" Margin="0,0,0,14">
                    <UniformGrid Columns="4">
                        <RadioButton Content="💵 Cash" GroupName="TenderType" IsChecked="{Binding IsCashSelected}" 
                                     Checked="TenderRadio_Checked" Tag="CASH" FontSize="13" FontWeight="Bold" 
                                     Cursor="Hand" Height="52" MinHeight="48" Margin="3">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tile" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                            CornerRadius="8" Padding="6,4" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tile" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <RadioButton Content="💳 Card" GroupName="TenderType" IsChecked="{Binding IsCardSelected}" 
                                     Checked="TenderRadio_Checked" Tag="CARD" FontSize="13" FontWeight="Bold" 
                                     Cursor="Hand" Height="52" MinHeight="48" Margin="3">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tile" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                            CornerRadius="8" Padding="6,4" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tile" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <RadioButton Content="📝 Credit" GroupName="TenderType" IsChecked="{Binding IsCreditSelected}" 
                                     Checked="TenderRadio_Checked" Tag="CREDIT" FontSize="13" FontWeight="Bold" 
                                     Cursor="Hand" Height="52" MinHeight="48" Margin="3">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tile" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                            CornerRadius="8" Padding="6,4" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tile" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <RadioButton Content="🔀 Split" GroupName="TenderType" IsChecked="{Binding IsSplitSelected}" 
                                     Checked="TenderRadio_Checked" Tag="SPLIT" FontSize="13" FontWeight="Bold" 
                                     Cursor="Hand" Height="52" MinHeight="48" Margin="3">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tile" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                            CornerRadius="8" Padding="6,4" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tile" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </UniformGrid>
                </Border>

                <!-- Customer Selection -->
                <StackPanel Margin="0,0,0,12">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Customer (for Credit / Ledger):" FontWeight="SemiBold" FontSize="13" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding CustomerAvailableCredit, StringFormat='Avail Credit: Rs. {0:#,##0.00}'}" 
                                   HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" 
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </DockPanel>
                    <ComboBox x:Name="CustomerCombo" Height="48" MinHeight="48" 
                              ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" 
                              DisplayMemberPath="Name" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Cash Tender View -->
                <StackPanel x:Name="CashTenderPanel">
                    <TextBlock Text="Cash Tendered" FontWeight="SemiBold" FontSize="13" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TenderBox" Height="48" MinHeight="48" FontSize="20" FontWeight="Bold" 
                             Padding="10,6" Style="{StaticResource TouchTextBoxStyle}"
                             Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Quick Cash Preset Buttons (Minimum 48x48px Hit Areas) -->
                    <UniformGrid Columns="4" Margin="0,8,0,12">
                        <Button Content="Exact" Height="48" MinHeight="48" MinWidth="48" Margin="2" 
                                Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                FontWeight="Bold" FontSize="13" Cursor="Hand" Click="Exact_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="+500" Height="48" MinHeight="48" MinWidth="48" Margin="2" 
                                Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                FontWeight="Bold" FontSize="13" Cursor="Hand" Click="Add500_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="+1,000" Height="48" MinHeight="48" MinWidth="48" Margin="2" 
                                Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                FontWeight="Bold" FontSize="13" Cursor="Hand" Click="Add1000_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="+5,000" Height="48" MinHeight="48" MinWidth="48" Margin="2" 
                                Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                FontWeight="Bold" FontSize="13" Cursor="Hand" Click="Add5000_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- Card Tender View -->
                <Border x:Name="CardTenderPanel" Visibility="Collapsed" 
                        Background="{DynamicResource InfoSurfaceBrush}" 
                        BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" 
                        CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <TextBlock Text="💳 Swipe / Tap customer card on bank POS machine. Ensure payment approves before completing sale." 
                               FontSize="13" Foreground="{DynamicResource InfoBrush}" TextWrapping="Wrap"/>
                </Border>

                <!-- Credit Tender View -->
                <Border x:Name="CreditTenderPanel" Visibility="Collapsed" 
                        Background="{DynamicResource WarningSurfaceBrush}" 
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" 
                        CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📝 Entire bill will be assigned to customer credit (&quot;Naya&quot;)." 
                                   FontWeight="Bold" FontSize="13" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Credit sales do NOT increase cash drawer expected cash." 
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Split Tender View -->
                <StackPanel x:Name="SplitTenderPanel" Visibility="Collapsed" Margin="0,0,0,8">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Credit Portion (Rs.)" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="CreditPortionBox" Height="48" MinHeight="48" FontSize="16" FontWeight="Bold" 
                                     Style="{StaticResource TouchTextBoxStyle}"
                                     Text="{Binding CreditAmount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cash Portion (Rs.)" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="CashPortionBox" Height="48" MinHeight="48" FontSize="16" FontWeight="Bold" 
                                     Style="{StaticResource TouchTextBoxStyle}"
                                     Text="{Binding CashAmount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Change Due Banner with Strict Rs. #,##0.00 Formatting -->
                <Border Background="{DynamicResource SuccessSurfaceBrush}" 
                        BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" 
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock Text="Change Due:" FontSize="15" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ChangeDue, StringFormat='Rs. {0:#,##0.00}'}" 
                                   FontSize="22" FontWeight="Bold" 
                                   HorizontalAlignment="Right" Foreground="{DynamicResource SuccessBrush}" 
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" 
                           FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <!-- Action Buttons (Height >= 56px) -->
                <DockPanel Margin="0,4,0,0">
                    <Button Content="Cancel" Width="120" Height="56" MinHeight="56" 
                            Click="Cancel_Click" Style="{StaticResource TouchSecondaryButtonStyle}"/>
                    <Button Content="Complete Sale" Height="56" MinHeight="56" Margin="12,0,0,0" 
                            Style="{StaticResource BigTenderButtonStyle}"
                            IsEnabled="{Binding CanComplete}" Click="Complete_Click"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
