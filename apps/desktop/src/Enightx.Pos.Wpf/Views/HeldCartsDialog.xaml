<Window x:Class="Enightx.Pos.Wpf.Views.HeldCartsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Held Bills - Park &amp; Recall" Height="560" Width="740"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource PosFontFamily}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="📋 Parked / Held Bills" FontSize="20" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Select a held bill to recall into active cart or discard." 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Held Carts Card Container (CornerRadius="12") -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                CornerRadius="12" Padding="12">
            <DataGrid x:Name="HeldCartsGrid" ItemsSource="{Binding HeldCarts}" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                      RowHeight="54" ColumnHeaderHeight="46"
                      Style="{StaticResource TouchDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Customer / Reference" Binding="{Binding CustomerReference}" 
                                        Width="*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Held Time" Binding="{Binding HeldAtUtc, StringFormat={}{0:HH:mm:ss}}" 
                                        Width="100"/>
                    <DataGridTextColumn Header="Items" Binding="{Binding Items.Count}" 
                                        Width="70"/>
                    <DataGridTextColumn Header="Total Amount" 
                                        Binding="{Binding GrandTotal, StringFormat='Rs. {0:#,##0.00}'}" 
                                        Width="140" FontWeight="Bold"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Action Buttons (Height >= 48px) -->
        <Border Grid.Row="2" Margin="0,18,0,0">
            <DockPanel>
                <Button Content="🗑️ Discard Selected" Width="160" Height="48" MinHeight="48" 
                        Background="{DynamicResource DangerSurfaceBrush}" Foreground="{DynamicResource DangerBrush}"
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        FontWeight="SemiBold" FontSize="13" Cursor="Hand" Click="Discard_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Width="110" Height="48" MinHeight="48" Margin="0,0,12,0" 
                            Style="{StaticResource TouchSecondaryButtonStyle}" 
                            Click="Close_Click"/>
                    <Button Content="⚡ Resume Bill" Width="160" Height="48" MinHeight="48" 
                            Style="{StaticResource TouchPrimaryButtonStyle}" 
                            Click="Resume_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
