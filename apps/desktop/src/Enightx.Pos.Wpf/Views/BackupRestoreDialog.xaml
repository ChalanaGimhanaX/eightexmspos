<Window x:Class="Enightx.Pos.Wpf.Views.BackupRestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database Backup &amp; Recovery" Height="480" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" Padding="14" CornerRadius="6" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="💾 LOCAL DATABASE BACKUP &amp; RECOVERY" FontWeight="Bold" FontSize="16" Foreground="White"/>
                <TextBlock Text="Point-in-Time SQLite Database Snapshots and Disaster Recovery" FontSize="12" Foreground="#BBDEFB" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Database Info & Actions -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- DB Info Card -->
                <Border Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="6"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ACTIVE LOCAL DATABASE" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="File Path:" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="DbPathText" Text="..." HorizontalAlignment="Right" MaxWidth="340" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Database Size:" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="DbSizeText" Text="0 KB" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Mode:" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="SQLite WAL (Write-Ahead Logging)" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#2E7D32"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Actions Card -->
                <Border Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="6"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="BACKUP &amp; RESTORE OPERATIONS" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                        <!-- Backup Section -->
                        <TextBlock Text="Create Point-in-Time Backup Snapshot:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Creates an exact copy of the active database with all transactions, inventory, and ledger history."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="📦 Export Database Backup Now" Height="38" Background="{StaticResource PrimaryBrush}"
                                Foreground="White" FontWeight="Bold" Margin="0,0,0,16" Click="ExportBackup_Click"/>

                        <!-- Restore Section -->
                        <Separator Margin="0,0,0,14"/>
                        <TextBlock Text="Restore from Backup File:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Restores the local database from a verified .db backup file. Note: The active application will require restart after restore."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="🔄 Select Backup File to Restore" Height="38" Background="#455A64"
                                Foreground="White" FontWeight="Bold" Click="RestoreBackup_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Close" Width="100" Height="36" Background="#ECEFF1" Foreground="#37474F"
                    FontWeight="SemiBold" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>

