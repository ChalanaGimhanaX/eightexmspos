<Window x:Class="Enightx.Pos.Wpf.Views.CustomerManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Credit &amp; 'Naya' Ledger" Height="740" Width="1120"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource PosFontFamily}"
        Loaded="Window_Loaded">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👥 Customer Credit (&quot;Naya&quot;) Management" FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="6" 
                            Padding="8,4" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="OFFLINE LEDGER" FontWeight="Bold" FontSize="11" 
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Border>
                </StackPanel>
                <Button Content="+ New Customer" Height="48" MinWidth="160" Padding="16,0" 
                        Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource TextOnPrimaryBrush}" 
                        FontWeight="Bold" FontSize="14" BorderThickness="0" HorizontalAlignment="Right" 
                        Cursor="Hand" Click="NewCustomer_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>
        </Border>

        <!-- Main Layout: 2 Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Customer Search & Master List Card -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="12" Padding="16" Margin="0,0,14,0">
                <DockPanel>
                    <!-- Search Box (Height >= 48px) -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource InputBackgroundBrush}" 
                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" 
                            CornerRadius="10" Height="48" Padding="10,0" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" 
                                       Margin="2,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Height="48" FontSize="14" 
                                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderThickness="0" VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Customers ListBox (Row Height >= 48px, Strict Rs. #,##0.00 Formatting) -->
                    <ListBox x:Name="CustomersListBox" SelectionChanged="CustomersListBox_SelectionChanged"
                             BorderThickness="0" Background="Transparent" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="MinHeight" Value="56"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{DynamicResource SurfaceBrush}" 
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                                    CornerRadius="8" Padding="12,10" SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="14" 
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <DockPanel Grid.Row="1" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Phone}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding OutstandingBalance, StringFormat='Due: Rs. {0:#,##0.00}'}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OutstandingBalance}" Value="0">
                                                            <Setter Property="Text" Value="No Due (Rs. 0.00)"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right Panel: Customer Details & Credit Ledger -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Customer Details & KPI Metrics Card -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                        CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="DetailNameText" Text="Select a customer" FontSize="18" FontWeight="Bold" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border x:Name="DetailActiveBadge" Background="{DynamicResource SuccessSurfaceBrush}" 
                                        BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" 
                                        CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Active" FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="DetailPhoneText" Text="" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DetailAddressText" Text="" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>

                        <!-- Balances KPI Badges & Edit Action -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Credit Limit" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DetailCreditLimitText" Text="Rs. 0.00" FontSize="15" FontWeight="Bold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}" 
                                    BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Outstanding (&quot;Naya&quot;)" FontSize="11" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DetailOutstandingText" Text="Rs. 0.00" FontSize="16" FontWeight="Bold" 
                                               Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource SuccessBrush}" 
                                    BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,12,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Available Credit" FontSize="11" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DetailAvailableText" Text="Rs. 0.00" FontSize="15" FontWeight="Bold" 
                                               Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button Content="✏️ Edit" Height="48" MinWidth="90" Style="{DynamicResource TouchSecondaryButtonStyle}" 
                                    Cursor="Hand" Click="EditCustomer_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Middle: Credit Ledger History Table Card -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                        CornerRadius="12" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="📜 Credit Ledger History" FontSize="15" FontWeight="Bold" 
                                   Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <DataGrid x:Name="LedgerGrid" Style="{DynamicResource TouchDataGridStyle}" 
                                  RowHeight="54" ColumnHeaderHeight="46"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding OccurredAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Entry Type" Binding="{Binding EntryType}" Width="130" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='Rs. {0:#,##0.00}'}" Width="130" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Balance After" Binding="{Binding BalanceAfter, StringFormat='Rs. {0:#,##0.00}'}" Width="130" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Reference / Receipt" Binding="{Binding ReferenceId}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Tender" Binding="{Binding PaymentMethod}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Bottom: Record Debt Repayment Card (All Inputs & Buttons >= 48px) -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                        CornerRadius="12" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Repayment (Rs.):" FontWeight="SemiBold" FontSize="14" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="PaymentAmountBox" Grid.Column="1" Height="48" FontSize="16" FontWeight="Bold" 
                                 Style="{DynamicResource TouchTextBoxStyle}"/>

                        <Button Grid.Column="2" Content="Pay Full" Height="48" MinWidth="90" Margin="8,0,12,0" 
                                Style="{DynamicResource TouchSecondaryButtonStyle}" Click="PayFull_Click"/>

                        <ComboBox x:Name="PaymentMethodCombo" Grid.Column="3" Height="48" SelectedIndex="0" 
                                  FontSize="14" VerticalContentAlignment="Center" Margin="0,0,12,0">
                            <ComboBoxItem Content="CASH"/>
                            <ComboBoxItem Content="CARD"/>
                        </ComboBox>

                        <TextBox x:Name="PaymentNotesBox" Grid.Column="4" Height="48" FontSize="14" 
                                 Style="{DynamicResource TouchTextBoxStyle}" Margin="0,0,12,0" ToolTip="Notes / Reference"/>

                        <Button Grid.Column="5" Content="💰 Record Payment" Height="48" MinWidth="180" 
                                Style="{DynamicResource TouchPrimaryButtonStyle}" Click="RecordPayment_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
