<Window x:Class="Enightx.Pos.Wpf.Views.CustomerManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Credit &amp; 'Naya' Ledger" Height="700" Width="1050"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👥 Customer Credit (&quot;Naya&quot;) Management" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <Border Background="#1E88E5" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="OFFLINE LEDGER" FontWeight="Bold" FontSize="11" Foreground="White"/>
                    </Border>
                </StackPanel>
                <Button Content="+ New Customer" Height="32" Padding="12,0" Background="#43A047" Foreground="White" 
                        FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand" Click="NewCustomer_Click"/>
            </DockPanel>
        </Border>

        <!-- Main Layout: 2 Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Customer Search & List -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0">
                <DockPanel>
                    <!-- Search Box -->
                    <Border DockPanel.Dock="Top" Background="#F0F4F8" CornerRadius="4" Padding="8,4" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="Gray"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Height="28" FontSize="13" Background="Transparent"
                                     BorderThickness="0" VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Customers ListBox -->
                    <ListBox x:Name="CustomersListBox" SelectionChanged="CustomersListBox_SelectionChanged"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Width="315">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <DockPanel Grid.Row="1" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="Gray"/>
                                            <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding OutstandingBalance, StringFormat='Due: LKR {0:N2}'}"/>
                                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OutstandingBalance}" Value="0">
                                                                <Setter Property="Text" Value="No Due"/>
                                                                <Setter Property="Foreground" Value="#388E3C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: Customer Details & Credit Ledger -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Customer Details Card -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="DetailNameText" Text="Select a customer" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                <Border x:Name="DetailActiveBadge" Background="#E8F5E9" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Active" FontSize="11" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="DetailPhoneText" Text="" FontSize="13" Foreground="Gray" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DetailAddressText" Text="" FontSize="12" Foreground="Gray"/>
                        </StackPanel>

                        <!-- Balances Card -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#F5F7FA" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Credit Limit" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DetailCreditLimitText" Text="LKR 0.00" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFEBEE" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Outstanding (&quot;Naya&quot;)" FontSize="11" Foreground="#C62828" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DetailOutstandingText" Text="LKR 0.00" FontSize="15" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#E8F5E9" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Available Credit" FontSize="11" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DetailAvailableText" Text="LKR 0.00" FontSize="14" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button Content="✏️ Edit" Height="32" Padding="10,0" Background="#ECEFF1" Foreground="#37474F"
                                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="EditCustomer_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Middle: Ledger History Table -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="📜 Credit Ledger History" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        <DataGrid x:Name="LedgerGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  RowHeight="32" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding OccurredAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Entry Type" Binding="{Binding EntryType}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=LKR {0:N2}}" Width="110" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Balance After" Binding="{Binding BalanceAfter, StringFormat=LKR {0:N2}}" Width="110" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Reference / Receipt" Binding="{Binding ReferenceId}" Width="130" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Tender" Binding="{Binding PaymentMethod}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Bottom: Record Debt Repayment -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Repayment (LKR):" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="PaymentAmountBox" Grid.Column="1" Height="34" FontSize="15" FontWeight="Bold" Padding="6,4" VerticalContentAlignment="Center"/>

                        <Button Grid.Column="2" Content="Pay Full" Height="34" Padding="8,0" Margin="6,0,14,0" Background="#ECEFF1" 
                                Foreground="#37474F" FontWeight="SemiBold" Click="PayFull_Click"/>

                        <ComboBox x:Name="PaymentMethodCombo" Grid.Column="3" Height="34" SelectedIndex="0" VerticalContentAlignment="Center" Margin="0,0,12,0">
                            <ComboBoxItem Content="CASH"/>
                            <ComboBoxItem Content="CARD"/>
                        </ComboBox>

                        <TextBox x:Name="PaymentNotesBox" Grid.Column="4" Height="34" FontSize="13" Padding="6,4" 
                                 VerticalContentAlignment="Center" Margin="0,0,12,0" ToolTip="Notes / Reference"/>

                        <Button Grid.Column="5" Content="💰 Record Payment" Height="34" Background="{StaticResource AccentBrush}"
                                Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Click="RecordPayment_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

