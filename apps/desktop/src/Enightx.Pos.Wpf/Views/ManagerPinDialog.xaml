<Window x:Class="Enightx.Pos.Wpf.Views.ManagerPinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager / Owner PIN Authorization" Height="380" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="🔒 Manager Authorization Required" FontSize="18" FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            
            <TextBlock x:Name="ActionDescriptionText" Text="This operation requires Manager or Owner approval." 
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" 
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Enter Manager / Owner PIN:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PinBox" Height="44" FontSize="22" FontWeight="Bold" Padding="8,4"
                         HorizontalContentAlignment="Center" KeyDown="PinBox_KeyDown"/>

            <TextBlock x:Name="ErrorText" Foreground="Red" FontSize="12" Margin="0,8,0,12" 
                       TextWrapping="Wrap" HorizontalAlignment="Center" Visibility="Collapsed"/>

            <DockPanel Margin="0,12,0,0">
                <Button Content="Cancel" Width="100" Height="42" Background="#ECEFF1" 
                        Foreground="#37474F" FontWeight="SemiBold" Click="Cancel_Click"/>
                <Button Content="Authorize" Height="42" Margin="12,0,0,0" 
                        Background="{StaticResource PrimaryBrush}" Foreground="White" 
                        FontWeight="Bold" FontSize="15" Click="Authorize_Click"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>

