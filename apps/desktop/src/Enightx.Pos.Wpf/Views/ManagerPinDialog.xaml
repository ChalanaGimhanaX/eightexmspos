<Window x:Class="Enightx.Pos.Wpf.Views.ManagerPinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager / Owner PIN Authorization" Height="640" Width="460"
        MinHeight="600" MinWidth="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource PosFontFamily}">
    
    <Grid Margin="20">
        <!-- Modern Card Container with CornerRadius="12" -->
        <Border Background="{DynamicResource SurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                CornerRadius="12" Padding="24">
            <StackPanel VerticalAlignment="Center">
                <!-- Header Icon & Title -->
                <TextBlock Text="🔒 Manager Authorization Required" FontSize="18" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                
                <!-- Action Description Card -->
                <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                    <TextBlock x:Name="ActionDescriptionText" Text="This operation requires Manager or Owner approval." 
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" 
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>

                <!-- PIN Label & Display Box (Height >= 48px) -->
                <TextBlock Text="Enter Manager / Owner PIN:" FontWeight="SemiBold" FontSize="14" 
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" 
                        BorderThickness="1.5" CornerRadius="8" Height="52" Padding="8,2" Margin="0,0,0,6">
                    <PasswordBox x:Name="PinBox" Height="48" FontSize="26" FontWeight="Bold" 
                                 Foreground="{DynamicResource TextPrimaryBrush}" Background="Transparent" 
                                 BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                                 KeyDown="PinBox_KeyDown"/>
                </Border>

                <!-- Error Text -->
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="13" FontWeight="SemiBold" 
                           Margin="0,4,0,8" TextWrapping="Wrap" HorizontalAlignment="Center" Visibility="Collapsed"/>

                <!-- On-Screen 3x4 Touch Numeric Keypad (Keys 0-9, Clear, Backspace >= 56x56px) -->
                <UniformGrid Columns="3" Margin="0,6,0,16">
                    <Button Content="1" Tag="1" Style="{DynamicResource TouchKeypadButtonStyle}" Height="56" Width="90" Click="Keypad_Click"/>
                    <Button Content="2" Tag="2" Style="{DynamicResource TouchKeypadButtonStyle}" Height="56" Width="90" Click="Keypad_Click"/>
                    <Button Content="3" Tag="3" Style="{DynamicResource TouchKeypadButtonStyle}" Height="56" Width="90" Click="Keypad_Click"/>

                    <Button Content="4" Tag="4" Style="{DynamicResource TouchKeypadButtonStyle}" Height="56" Width="90" Click="Keypad_Click"/>
                    <Button Content="5" Tag="5" Style="{DynamicResource TouchKeypadButtonStyle}" Height="56" Width="90" Click="Keypad_Click"/>
                    <Button Content="6" Tag="6" Style="{DynamicResource TouchKeypadButtonStyle}" Height="56" Width="90" Click="Keypad_Click"/>

                    <Button Content="7" Tag="7" Style="{DynamicResource TouchKeypadButtonStyle}" Height="56" Width="90" Click="Keypad_Click"/>
                    <Button Content="8" Tag="8" Style="{DynamicResource TouchKeypadButtonStyle}" Height="56" Width="90" Click="Keypad_Click"/>
                    <Button Content="9" Tag="9" Style="{DynamicResource TouchKeypadButtonStyle}" Height="56" Width="90" Click="Keypad_Click"/>

                    <Button Content="C" Tag="CLEAR" Style="{DynamicResource TouchKeypadButtonStyle}" Height="56" Width="90" 
                            Background="{DynamicResource DangerSurfaceBrush}" Foreground="{DynamicResource DangerBrush}" 
                            Click="Clear_Click" ToolTip="Clear entered PIN"/>
                    <Button Content="0" Tag="0" Style="{DynamicResource TouchKeypadButtonStyle}" Height="56" Width="90" Click="Keypad_Click"/>
                    <Button Content="⌫" Tag="BACK" Style="{DynamicResource TouchKeypadButtonStyle}" Height="56" Width="90" 
                            Click="Backspace_Click" ToolTip="Backspace last digit"/>
                </UniformGrid>

                <!-- Action Buttons (Height >= 48px) -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancel" Height="48" MinWidth="120" 
                            Style="{DynamicResource TouchSecondaryButtonStyle}" Click="Cancel_Click" IsCancel="True"/>
                    <Button Grid.Column="2" Content="Authorize" Height="48" MinWidth="120" 
                            Style="{DynamicResource TouchPrimaryButtonStyle}" Click="Authorize_Click" IsDefault="True"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
