<Window x:Class="Enightx.Pos.Wpf.Views.InventoryValuationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Valuation &amp; Stock Status Report" Height="780" Width="1020"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA" Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="📋 Inventory Valuation &amp; Stock Status Report" FontSize="20" FontWeight="Bold" Foreground="#1A365D"/>
                    <TextBlock x:Name="SubtitleText" Text="Loading inventory valuation..." FontSize="13" Foreground="#718096" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh" Height="34" Padding="12,0" Margin="0,0,8,0"
                            Background="#EDF2F7" Foreground="#2D3748" FontWeight="SemiBold" BorderThickness="1" BorderBrush="#CBD5E0" Cursor="Hand"
                            Click="Refresh_Click"/>
                    <Button Content="🖨️ Print Valuation" Height="34" Padding="14,0"
                            Background="#2B6CB0" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            Click="Print_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Top Valuation KPI Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Asset Valuation at Cost -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="TOTAL VALUATION (COST)" Foreground="#718096" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="ValuationCostText" Text="LKR 0.00" FontWeight="Bold" FontSize="18" Foreground="#2B6CB0" Margin="0,4,0,2"/>
                    <TextBlock Text="Store asset investment base" FontSize="11" Foreground="#A0AEC0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Asset Valuation at Retail -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="TOTAL VALUATION (RETAIL)" Foreground="#718096" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="ValuationRetailText" Text="LKR 0.00" FontWeight="Bold" FontSize="18" Foreground="#1A365D" Margin="0,4,0,2"/>
                    <TextBlock Text="Expected shelf gross revenue" FontSize="11" Foreground="#A0AEC0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Potential Gross Margin -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="POTENTIAL GROSS PROFIT" Foreground="#718096" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="PotentialProfitText" Text="LKR 0.00" FontWeight="Bold" FontSize="18" Foreground="#38A169" Margin="0,4,0,2"/>
                    <TextBlock x:Name="PotentialMarginPctText" Text="Expected margin: 0.0%" FontSize="11" Foreground="#2F855A" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Stock Alerts -->
            <Border Grid.Column="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="STOCK HEALTH ALERTS" Foreground="#718096" FontSize="11" FontWeight="Bold"/>
                    <DockPanel Margin="0,4,0,2">
                        <TextBlock Text="⚠️ Low Stock (&lt;= 5):" FontSize="12" Foreground="#D97706" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LowStockCountText" Text="0" FontSize="13" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="🚨 Oversold (&lt; 0):" FontSize="12" Foreground="#DC2626" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NegativeStockCountText" Text="0" FontSize="13" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter & Search Toolbar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Border Grid.Column="0" Background="#F7FAFC" CornerRadius="6" BorderThickness="1" BorderBrush="#E2E8F0" Padding="8,4" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="Gray"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Height="28" FontSize="13" Background="Transparent"
                                 BorderThickness="0" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="1" Text="Stock Filter:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,8,0"/>
                <ComboBox x:Name="StockFilterComboBox" Grid.Column="2" Height="34" VerticalContentAlignment="Center"
                          SelectionChanged="StockFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="All Products" IsSelected="True"/>
                    <ComboBoxItem Content="⚠️ Low Stock Alert (&lt;= 5)"/>
                    <ComboBoxItem Content="🚨 Oversold / Negative Stock (&lt; 0)"/>
                    <ComboBoxItem Content="✅ Healthy Stock (&gt; 5)"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Inventory Valuation Items Table -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="2">
            <DataGrid x:Name="ValuationGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36"
                      BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="110" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="*" FontWeight="Normal"/>
                    <DataGridTextColumn Header="Stock On Hand" Binding="{Binding StockOnHand, StringFormat={}{0:N2}}" Width="110" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Cost Basis" Binding="{Binding CostBasis, StringFormat=LKR {0:N2}}" Width="115"/>
                    <DataGridTextColumn Header="Retail Price" Binding="{Binding UnitPrice, StringFormat=LKR {0:N2}}" Width="115"/>
                    <DataGridTextColumn Header="Valuation @ Cost" Binding="{Binding ValuationAtCost, StringFormat=LKR {0:N2}}" Width="135" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Valuation @ Retail" Binding="{Binding ValuationAtRetail, StringFormat=LKR {0:N2}}" Width="135" FontWeight="SemiBold"/>
                    <DataGridTemplateColumn Header="Status Alert" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNegativeStock}" Value="True">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding AlertStatus}" FontWeight="Bold" FontSize="11" Foreground="{Binding AlertColor}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock x:Name="FooterCountText" Text="Showing 0 products" VerticalAlignment="Center" Foreground="#718096" FontSize="13"/>
                <Button Content="Close" Width="100" Height="36" HorizontalAlignment="Right"
                        Background="#EDF2F7" Foreground="#4A5568" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

