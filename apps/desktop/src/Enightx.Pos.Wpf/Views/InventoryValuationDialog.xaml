<Window x:Class="Enightx.Pos.Wpf.Views.InventoryValuationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Valuation &amp; Stock Status Report" Height="800" Width="1060"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource PosFontFamily}"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="📋 Inventory Valuation &amp; Stock Status Report" FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SubtitleText" Text="Loading inventory valuation..." FontSize="13" 
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh" Height="48" MinHeight="48" Padding="16,0" Margin="0,0,8,0"
                            Style="{StaticResource TouchSecondaryButtonStyle}"
                            Click="Refresh_Click"/>
                    <Button Content="🖨️ Print Valuation" Height="48" MinHeight="48" Padding="18,0"
                            Style="{StaticResource TouchPrimaryButtonStyle}"
                            Click="Print_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Top Valuation KPI Summary Cards (Modern Containers, CornerRadius="12") -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Asset Valuation at Cost -->
            <Border Grid.Column="0" Background="{DynamicResource CardBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="12" Padding="16" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="TOTAL VALUATION (COST)" Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="ValuationCostText" Text="Rs. 0.00" FontWeight="Bold" 
                               FontSize="18" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,2"/>
                    <TextBlock Text="Store asset investment base" FontSize="11" 
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Asset Valuation at Retail -->
            <Border Grid.Column="1" Background="{DynamicResource CardBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="12" Padding="16" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="TOTAL VALUATION (RETAIL)" Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="ValuationRetailText" Text="Rs. 0.00" FontWeight="Bold" 
                               FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,2"/>
                    <TextBlock Text="Expected shelf gross revenue" FontSize="11" 
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Potential Gross Margin -->
            <Border Grid.Column="2" Background="{DynamicResource CardBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="12" Padding="16" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="POTENTIAL GROSS PROFIT" Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="PotentialProfitText" Text="Rs. 0.00" FontWeight="Bold" 
                               FontSize="18" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,2"/>
                    <TextBlock x:Name="PotentialMarginPctText" Text="Expected margin: 0.0%" FontSize="11" 
                               Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Stock Alerts -->
            <Border Grid.Column="3" Background="{DynamicResource CardBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="12" Padding="16" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="STOCK HEALTH ALERTS" Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="11" FontWeight="Bold"/>
                    <DockPanel Margin="0,6,0,2">
                        <TextBlock Text="⚠️ Low Stock (&lt;= 5):" FontSize="12" 
                                   Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LowStockCountText" Text="0" FontSize="13" FontWeight="Bold" 
                                   Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="🚨 Oversold (&lt; 0):" FontSize="12" 
                                   Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NegativeStockCountText" Text="0" FontSize="13" FontWeight="Bold" 
                                   Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter & Search Toolbar (CornerRadius="12", Height >= 48px targets) -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                CornerRadius="12" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input Container (Height="48") -->
                <Border Grid.Column="0" Background="{DynamicResource InputBackgroundBrush}" 
                        CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" 
                        Padding="10,4" Margin="0,0,12,0" Height="48">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="4,0,8,0" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="14" Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="0" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="1" Text="Stock Filter:" VerticalAlignment="Center" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                <ComboBox x:Name="StockFilterComboBox" Grid.Column="2" Height="48" MinHeight="48" 
                          VerticalContentAlignment="Center" FontSize="13"
                          SelectionChanged="StockFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="All Products" IsSelected="True"/>
                    <ComboBoxItem Content="⚠️ Low Stock Alert (&lt;= 5)"/>
                    <ComboBoxItem Content="🚨 Oversold / Negative Stock (&lt; 0)"/>
                    <ComboBoxItem Content="✅ Healthy Stock (&gt; 5)"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Inventory Valuation Items Table (Strict Rs. #,##0.00 formatting, RowHeight >= 52px) -->
        <Border Grid.Row="3" Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                CornerRadius="12" Padding="8">
            <DataGrid x:Name="ValuationGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                      RowHeight="52" ColumnHeaderHeight="46"
                      Style="{StaticResource TouchDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="*" FontWeight="Normal"/>
                    <DataGridTextColumn Header="Stock On Hand" Binding="{Binding StockOnHand, StringFormat={}{0:N2}}" Width="120" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Cost Basis" Binding="{Binding CostBasis, StringFormat='Rs. {0:#,##0.00}'}" Width="130"/>
                    <DataGridTextColumn Header="Retail Price" Binding="{Binding UnitPrice, StringFormat='Rs. {0:#,##0.00}'}" Width="130"/>
                    <DataGridTextColumn Header="Valuation @ Cost" Binding="{Binding ValuationAtCost, StringFormat='Rs. {0:#,##0.00}'}" Width="150" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Valuation @ Retail" Binding="{Binding ValuationAtRetail, StringFormat='Rs. {0:#,##0.00}'}" Width="150" FontWeight="SemiBold"/>
                    <DataGridTemplateColumn Header="Status Alert" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNegativeStock}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding AlertStatus}" FontWeight="Bold" FontSize="11" 
                                               Foreground="{Binding AlertColor}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock x:Name="FooterCountText" Text="Showing 0 products" VerticalAlignment="Center" 
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                <Button Content="Close" Width="120" Height="48" MinHeight="48" HorizontalAlignment="Right"
                        Style="{StaticResource TouchSecondaryButtonStyle}"
                        Click="Close_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
