<UserControl x:Class="Enightx.Pos.Wpf.Views.StockTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000" Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" Padding="16,8">
            <DockPanel>
                <TextBlock Text="INTER-BRANCH STOCK TRANSFERS" FontWeight="Bold" FontSize="18" Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="← Back to POS (F1)" Height="34" Padding="14,2" Background="#1E88E5" Foreground="White"
                            FontWeight="Bold" Click="BackToPos_Click" Margin="0,0,12,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Create Transfer Form -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="NEW STOCK TRANSFER REQUEST" FontWeight="Bold" FontSize="15" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Source Branch:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SourceBranchCombo" Height="36" Margin="0,0,0,12" SelectedIndex="0">
                        <ComboBoxItem Content="B01 (Colombo Main)"/>
                        <ComboBoxItem Content="B02 (Kandy Branch)"/>
                        <ComboBoxItem Content="B03 (Galle Branch)"/>
                    </ComboBox>

                    <TextBlock Text="Destination Branch:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DestBranchCombo" Height="36" Margin="0,0,0,12" SelectedIndex="1">
                        <ComboBoxItem Content="B01 (Colombo Main)"/>
                        <ComboBoxItem Content="B02 (Kandy Branch)"/>
                        <ComboBoxItem Content="B03 (Galle Branch)"/>
                    </ComboBox>

                    <TextBlock Text="Select Product:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ProductCombo" Height="36" Margin="0,0,0,12" DisplayMemberPath="Name" SelectedValuePath="ProductId"/>

                    <TextBlock Text="Transfer Quantity:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="QuantityInput" Height="36" FontSize="16" FontWeight="Bold" Padding="8,2" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                    <Button Content="Request Transfer" Height="40" Background="{StaticResource PrimaryBrush}" Foreground="White"
                            FontWeight="Bold" FontSize="15" Click="RequestTransfer_Click"/>

                    <TextBlock Text="Note: Transfers move stock into IN-TRANSIT upon dispatch, preventing phantom inventory." 
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>

            <!-- Transfers List & Actions -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <!-- Action Bar -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="TRANSFER LOGS" FontWeight="Bold" FontSize="15" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DispatchBtn" Content="Dispatch Items (Source)" Height="34" Padding="12,2" Margin="0,0,8,0"
                                    Background="#F57C00" Foreground="White" FontWeight="Bold" Click="Dispatch_Click"/>
                            <Button x:Name="ReceiveBtn" Content="Receive Items (Destination)" Height="34" Padding="12,2"
                                    Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="Bold" Click="Receive_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Transfers Grid -->
                    <DataGrid x:Name="TransfersGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Single" SelectionChanged="TransfersGrid_SelectionChanged"
                              Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Transfer ID" Binding="{Binding TransferId}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="From" Binding="{Binding SourceBranchId}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="To" Binding="{Binding DestBranchId}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductId}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat={}{0:F0}}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

