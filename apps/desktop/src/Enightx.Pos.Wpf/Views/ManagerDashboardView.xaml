<UserControl x:Class="Enightx.Pos.Wpf.Views.ManagerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100" Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" Padding="16,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊 STORE MANAGER &amp; OWNER DASHBOARD" FontWeight="Bold" FontSize="18" Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#2E7D32" CornerRadius="12" Padding="10,2" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RoleBadgeText" Text="ROLE: MANAGER" Foreground="White" FontWeight="Bold" FontSize="11"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh Data" Height="34" Padding="12,2" Margin="0,0,8,0"
                            Background="#1E88E5" Foreground="White" FontWeight="Bold" Click="Refresh_Click"/>
                    <Button Content="← Back to POS (F1)" Height="34" Padding="14,2" Background="#37474F" Foreground="White"
                            FontWeight="Bold" Click="BackToPos_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <!-- Section 1: KPI Cards -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Today's Revenue -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="TODAY'S REVENUE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TodayRevenueText" Text="LKR 0.00" FontWeight="Bold" FontSize="22" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="OrdersCountText" Text="0 Transactions" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Average Ticket Size -->
                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="AVG TICKET SIZE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AvgTicketText" Text="LKR 0.00" FontWeight="Bold" FontSize="22" Margin="0,6,0,0"/>
                            <TextBlock Text="Per Completed Sale" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Customer Debt -->
                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="OUTSTANDING DEBT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CustomerDebtText" Text="LKR 0.00" FontWeight="Bold" FontSize="22" Foreground="#C62828" Margin="0,6,0,0"/>
                            <TextBlock Text="Across All Customers" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Drawer Status -->
                    <Border Grid.Column="3" Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="DRAWER BALANCE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DrawerCashText" Text="LKR 0.00" FontWeight="Bold" FontSize="22" Foreground="#2E7D32" Margin="0,6,0,0"/>
                            <TextBlock x:Name="DrawerShiftText" Text="Shift: Active" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Section 2: Tender Breakdown & Inventory Alerts -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tender Breakdown Card -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="TENDER BREAKDOWN" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                            
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="💵 Cash:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TenderCashText" Text="LKR 0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="💳 Card (POS Terminal):" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TenderCardText" Text="LKR 0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="📱 QR (LANKAQR):" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TenderQrText" Text="LKR 0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="📝 Credit / Customer Debt:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TenderCreditText" Text="LKR 0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>

                            <Separator Margin="0,8,0,12"/>

                            <Button Content="Print End-of-Day Z-Report" Height="36" Background="#ECEFF1" Foreground="#37474F"
                                    FontWeight="SemiBold" Click="PrintZReport_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Low Stock Alerts Card -->
                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="LOW &amp; NEGATIVE STOCK ALERTS (A06)" FontWeight="Bold" FontSize="14" Foreground="#C62828" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LowStockCountBadge" Text="0 items" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            
                            <DataGrid x:Name="LowStockGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                      Height="160" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Stock on Hand" Binding="{Binding StockOnHand, StringFormat={}{0:F0}}" Width="120" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=LKR {0:F2}}" Width="120" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Section 3: Manager Controls (Stock Adjustment & Security Audit) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Manual Stock Adjustment (A09 Rule: Manager/Owner Only) -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,16,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="MANUAL STOCK ADJUSTMENT (A09)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="🔒 Manager Only" Foreground="#C62828" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Select Product:" FontSize="12" Margin="0,0,0,2"/>
                            <ComboBox x:Name="AdjustProductCombo" Height="34" Margin="0,0,0,8" DisplayMemberPath="Name" SelectedValuePath="ProductId"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="New Stock Qty:" FontSize="12" Margin="0,0,0,2"/>
                                    <TextBox x:Name="AdjustQtyInput" Height="34" Padding="6,2" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Reason:" FontSize="12" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="AdjustReasonCombo" Height="34" SelectedIndex="0">
                                        <ComboBoxItem Content="Stock Audit Count"/>
                                        <ComboBoxItem Content="Damaged / Broken"/>
                                        <ComboBoxItem Content="Expired Goods"/>
                                        <ComboBoxItem Content="Inventory Correction"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Adjustment Notes / Justification:" FontSize="12" Margin="0,0,0,2"/>
                            <TextBox x:Name="AdjustNotesInput" Height="34" Padding="6,2" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

                            <Button Content="Commit Stock Adjustment" Height="38" Background="{StaticResource AccentBrush}" Foreground="White"
                                    FontWeight="Bold" Click="CommitStockAdjustment_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Security & Audit Event Log (A08 Price Overrides & Refunds) -->
                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="SECURITY &amp; AUDIT TRAIL (A08 Price Overrides / Refunds / Adjustments)" 
                                       FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="AuditLogGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                      Height="210" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Timestamp" Binding="{Binding OccurredAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Actor" Binding="{Binding ActorId}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Details" Binding="{Binding DetailsJson}" Width="*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

