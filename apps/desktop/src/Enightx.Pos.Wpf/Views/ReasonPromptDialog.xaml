<Window x:Class="Enightx.Pos.Wpf.Views.ReasonPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Reason Required" Height="260" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptTitle" Text="Enter reason for this action (A08 Audit Log):" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <TextBox x:Name="ReasonInput" Grid.Row="1" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                 Padding="8" FontSize="13" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Height="36" Margin="0,0,10,0" Background="#ECEFF1" Foreground="#37474F"
                    FontWeight="SemiBold" Click="Cancel_Click"/>
            <Button Content="Confirm" Width="100" Height="36" Background="{StaticResource PrimaryBrush}" Foreground="White"
                    FontWeight="Bold" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>

