<Window x:Class="Enightx.Pos.Wpf.Views.OpenShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Cashier Shift" Height="480" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F7FA" Loaded="Window_Loaded">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="🔓 Shift Opening &amp; Cash Float" FontSize="20" FontWeight="Bold" Foreground="#1A365D"/>
                <TextBlock Text="Count all physical cash in the drawer and enter the opening float before accessing billing." 
                           FontSize="13" Foreground="#718096" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Main Form Card -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel>
                <!-- Context Summary -->
                <Border Background="#EDF2F7" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CASHIER" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                            <TextBlock x:Name="CashierText" Text="Cashier Name" FontSize="14" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="TERMINAL" FontSize="11" FontWeight="Bold" Foreground="#718096" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="StationText" Text="Branch: B01 | Counter: C01" FontSize="13" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Input Label -->
                <TextBlock Text="Opening Cash Float (LKR):" FontWeight="Bold" FontSize="14" Foreground="#1A365D" Margin="0,0,0,6"/>
                <TextBlock Text="Enter the total count of currency notes and coins placed in the cash drawer." 
                           FontSize="12" Foreground="#718096" Margin="0,0,0,10"/>

                <!-- Amount Input Box with LKR Prefix -->
                <Border BorderBrush="#CBD5E0" BorderThickness="1.5" CornerRadius="6" Background="#FAFAFA">
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#EDF2F7" BorderBrush="#CBD5E0" BorderThickness="0,0,1,0" CornerRadius="5,0,0,5">
                            <TextBlock Text="LKR" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="15" Foreground="#4A5568"/>
                        </Border>
                        <TextBox x:Name="FloatBox" Grid.Column="1" Height="46" FontSize="22" FontWeight="Bold" 
                                 Padding="10,6" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                 Text="0.00" KeyDown="FloatBox_KeyDown" TextChanged="FloatBox_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Quick Amount Presets -->
                <TextBlock Text="Quick Presets (LKR):" FontSize="12" FontWeight="SemiBold" Foreground="#718096" Margin="0,12,0,6"/>
                <UniformGrid Columns="4" Margin="0,0,0,10">
                    <Button Content="0.00" Height="32" Margin="0,0,4,0" Background="#EDF2F7" Foreground="#2B6CB0" 
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="Preset_Click" Tag="0.00"/>
                    <Button Content="2,500" Height="32" Margin="4,0,4,0" Background="#EDF2F7" Foreground="#2B6CB0" 
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="Preset_Click" Tag="2500.00"/>
                    <Button Content="5,000" Height="32" Margin="4,0,4,0" Background="#EDF2F7" Foreground="#2B6CB0" 
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="Preset_Click" Tag="5000.00"/>
                    <Button Content="10,000" Height="32" Margin="4,0,0,0" Background="#EDF2F7" Foreground="#2B6CB0" 
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="Preset_Click" Tag="10000.00"/>
                </UniformGrid>

                <!-- Validation Error Display -->
                <TextBlock x:Name="ErrorText" Foreground="#E53E3E" FontSize="12" FontWeight="SemiBold" 
                           Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <DockPanel>
                <Button Content="Cancel / Log Out" Width="130" Height="40" Background="#EDF2F7" Foreground="#4A5568"
                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" IsCancel="True"/>
                <Button Content="🔓 Confirm &amp; Open Shift" Width="190" Height="40" HorizontalAlignment="Right"
                        Background="#2B6CB0" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0"
                        Cursor="Hand" Click="ConfirmOpen_Click" IsDefault="True"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

