<Window x:Class="Enightx.Pos.Wpf.Views.OpenShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Cashier Shift" Height="540" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource PosFontFamily}"
        Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="🔓 Shift Opening &amp; Cash Float" 
                           FontSize="20" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Count all physical cash in the drawer and enter the opening float before accessing billing." 
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" 
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Main Form Card Container (CornerRadius="12") -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                CornerRadius="12" Padding="20">
            <StackPanel>
                <!-- Context Summary -->
                <Border Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                        CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CASHIER" FontSize="11" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="CashierText" Text="Cashier Name" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="TERMINAL" FontSize="11" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="StationText" Text="Branch: B01 | Counter: C01" 
                                       FontSize="13" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Input Label -->
                <TextBlock Text="Opening Cash Float (Rs.):" FontWeight="Bold" FontSize="14" 
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Enter the total count of currency notes and coins placed in the cash drawer." 
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                <!-- Amount Input Box with Rs. Prefix (Height >= 48px) -->
                <Border BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" 
                        CornerRadius="10" Background="{DynamicResource InputBackgroundBrush}">
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardHoverBrush}" 
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" 
                                CornerRadius="10,0,0,10">
                            <TextBlock Text="Rs." HorizontalAlignment="Center" VerticalAlignment="Center" 
                                       FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <TextBox x:Name="FloatBox" Grid.Column="1" Height="48" FontSize="22" FontWeight="Bold" 
                                 Padding="10,6" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                 Text="0.00" KeyDown="FloatBox_KeyDown" TextChanged="FloatBox_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Quick Amount Presets (>= 48x48px hit areas & strict Rs. #,##0.00 formatting) -->
                <TextBlock Text="Quick Presets:" FontSize="12" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,8"/>
                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <Button Content="Rs. 0.00" Height="48" MinHeight="48" MinWidth="48" Margin="0,0,4,0" 
                            Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="Preset_Click" Tag="0.00">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Rs. 2,500.00" Height="48" MinHeight="48" MinWidth="48" Margin="4,0,4,0" 
                            Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                            FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="Preset_Click" Tag="2500.00">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Rs. 5,000.00" Height="48" MinHeight="48" MinWidth="48" Margin="4,0,4,0" 
                            Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                            FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="Preset_Click" Tag="5000.00">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Rs. 10,000.00" Height="48" MinHeight="48" MinWidth="48" Margin="4,0,0,0" 
                            Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                            FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="Preset_Click" Tag="10000.00">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </UniformGrid>

                <!-- Validation Error Display -->
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" 
                           FontSize="12" FontWeight="SemiBold" 
                           Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Footer Action Buttons (Height >= 48px) -->
        <Border Grid.Row="2" Margin="0,18,0,0">
            <DockPanel>
                <Button Content="Cancel / Log Out" Width="150" Height="48" MinHeight="48" 
                        Style="{StaticResource TouchSecondaryButtonStyle}" 
                        Click="Cancel_Click" IsCancel="True"/>
                <Button Content="🔓 Confirm &amp; Open Shift" Width="220" Height="48" MinHeight="48" 
                        HorizontalAlignment="Right"
                        Style="{StaticResource TouchPrimaryButtonStyle}" 
                        Click="ConfirmOpen_Click" IsDefault="True"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
