<UserControl x:Class="Enightx.Pos.Wpf.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Filter Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="14" CornerRadius="6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧾 SALES HISTORY &amp; RETURNS" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBox x:Name="SearchBox" Width="260" Height="36" Padding="8,4" VerticalContentAlignment="Center"
                             ToolTip="Search by Receipt Number, Cashier or Customer" TextChanged="SearchBox_TextChanged"/>
                    <Button Content="🔍 Search" Height="36" Padding="12,0" Margin="8,0,0,0"
                            Background="{StaticResource PrimaryBrush}" Foreground="White" FontWeight="SemiBold"
                            Click="Search_Click"/>
                    <Button Content="🔄 Refresh" Height="36" Padding="12,0" Margin="8,0,0,0"
                            Background="#ECEFF1" Foreground="#37474F" FontWeight="SemiBold"
                            Click="Refresh_Click"/>
                </StackPanel>

                <Button Content="⬅ Back to POS Billing" Height="36" Padding="14,0" HorizontalAlignment="Right"
                        Background="#37474F" Foreground="White" FontWeight="SemiBold"
                        Click="BackToPos_Click"/>
            </DockPanel>
        </Border>

        <!-- Main Content: Two Columns (Master-Detail) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Sales List -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock Text="COMPLETED TRANSACTIONS" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="14,12,14,8" DockPanel.Dock="Top"/>
                    <DataGrid x:Name="SalesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                              RowHeight="38" GridLinesVisibility="Horizontal"
                              SelectionChanged="SalesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Receipt No" Binding="{Binding ReceiptNumber}" Width="140" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Date / Time (UTC)" Binding="{Binding CreatedAtUtc, StringFormat={}{0:MM/dd HH:mm}}" Width="100"/>
                            <DataGridTextColumn Header="Total (LKR)" Binding="{Binding GrandTotal, StringFormat={}{0:N2}}" Width="95"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Right: Selected Sale Details & Actions -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SaleDetailsPanel" Visibility="Collapsed">
                        <!-- Receipt Summary Header -->
                        <Border Background="{StaticResource PrimaryDarkBrush}" Padding="14" CornerRadius="6" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="DetailReceiptNo" Text="RECEIPT: B01-C01-000001" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                    <TextBlock x:Name="DetailMeta" Text="Date: ... | Cashier: ... | Customer: ..." FontSize="12" Foreground="#BBDEFB" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailTotal" Text="LKR 0.00" FontWeight="Bold" FontSize="20" Foreground="#81C784" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="DetailStatus" Text="STATUS: COMPLETED" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Bill Line Items -->
                        <TextBlock Text="LINE ITEMS" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" RowHeight="34" MaxHeight="220" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120"/>
                                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat={}{0:F0}}" Width="60"/>
                                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=LKR {0:N2}}" Width="110"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=LKR {0:N2}}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Tenders Summary -->
                        <TextBlock Text="PAYMENT TENDERS" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <DataGrid x:Name="TendersGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" RowHeight="30" MaxHeight="120" Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tender Type" Binding="{Binding TenderType}" Width="130" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Amount Tendered" Binding="{Binding AmountTendered, StringFormat=LKR {0:N2}}" Width="130"/>
                                <DataGridTextColumn Header="Change Given" Binding="{Binding ChangeGiven, StringFormat=LKR {0:N2}}" Width="120"/>
                                <DataGridTextColumn Header="Reference" Binding="{Binding PaymentReference}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Action Buttons -->
                        <Border Background="#F5F5F5" Padding="14" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TRANSACTION ACTIONS" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button x:Name="ReprintBtn" Content="🖨 Reprint Receipt" Height="38" Padding="14,0" Margin="0,0,10,6"
                                            Background="#1565C0" Foreground="White" FontWeight="Bold"
                                            Click="ReprintReceipt_Click"/>
                                    <Button x:Name="RefundBtn" Content="↩ Process Return / Refund" Height="38" Padding="14,0" Margin="0,0,10,6"
                                            Background="#D84315" Foreground="White" FontWeight="Bold"
                                            Click="ProcessRefund_Click"/>
                                    <Button x:Name="CancelSaleBtn" Content="⛔ Cancel Sale" Height="38" Padding="14,0" Margin="0,0,10,6"
                                            Background="#C62828" Foreground="White" FontWeight="Bold"
                                            Click="CancelSale_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

