<Window x:Class="Enightx.Pos.Wpf.Views.ShiftReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shift &amp; Cash Reconciliation Report" Height="700" Width="750"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}" Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="📊 Shift Summary &amp; Reconciliation Report" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock x:Name="SubtitleText" Text="Loading shift report..." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="🖨️ Print Report" Height="34" Padding="14,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource TextOnPrimaryBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="Print_Click"/>
            </DockPanel>
        </Border>

        <!-- Report Scroll Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Section 1: Sales & Refunds Summary -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SALES &amp; REFUNDS SUMMARY" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total Sales Count:" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock x:Name="SalesCountText" Text="0" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Gross Sales Revenue:" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock x:Name="GrossSalesText" Text="Rs. 0.00" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Total Cash Refunds:" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock x:Name="RefundsText" Text="Rs. 0.00" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource DangerBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 2: Tender Breakdown Table -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SALES BY TENDER TYPE" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="TenderGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tender Type" Binding="{Binding TenderType}" Width="120" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Txn Count" Binding="{Binding TransactionCount}" Width="90"/>
                                <DataGridTextColumn Header="Total Tendered" Binding="{Binding TotalTendered, StringFormat=Rs. {0:N2}}" Width="140"/>
                                <DataGridTextColumn Header="Change Given" Binding="{Binding ChangeGiven, StringFormat=Rs. {0:N2}}" Width="130"/>
                                <DataGridTextColumn Header="Net Amount" Binding="{Binding NetAmount, StringFormat=Rs. {0:N2}}" Width="*" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Section 3: Cash Drawer Reconciliation -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CASH DRAWER RECONCILIATION" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Opening Float:" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="RepFloatText" Text="Rs. 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="(+) Net Cash Sales:" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="RepNetCashText" Text="Rs. 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="(-) Cash Refunds:" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="RepRefundsText" Text="Rs. 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="(+) Cash In (Deposits):" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="RepCashInText" Text="Rs. 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="(-) Cash Out (Payouts):" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="RepCashOutText" Text="Rs. 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                        </DockPanel>
                        <Separator Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Expected Drawer Cash:" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock x:Name="RepExpectedText" Text="Rs. 0.00" HorizontalAlignment="Right" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryBrush}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Actual Counted Cash:" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock x:Name="RepCountedText" Text="Rs. 0.00" HorizontalAlignment="Right" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ForegroundBrush}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Drawer Cash Variance:" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock x:Name="RepVarianceText" Text="Rs. 0.00" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource SuccessBrush}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Section 4: Gross Profit Breakdown -->
                <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="GROSS PROFIT BREAKDOWN" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Net Sales Revenue:" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="ProfitRevText" Text="Rs. 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Cost of Goods Sold (COGS):" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="ProfitCogsText" Text="Rs. 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                        </DockPanel>
                        <Separator Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Gross Profit:" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock x:Name="GrossProfitText" Text="Rs. 0.00" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryBrush}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Gross Margin %:" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="GrossMarginText" Text="0.00%" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SuccessBrush}"/>
                        </DockPanel>
                        <TextBlock Text="* Gross Profit only (excludes operating, staff, and store rental expenses)." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,14,0,0">
            <Button Content="Close" Width="100" Height="36" HorizontalAlignment="Right"
                    Background="{DynamicResource SurfaceCardBrush}" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                    Click="Close_Click"/>
        </Border>
    </Grid>
</Window>

